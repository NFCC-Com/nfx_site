---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "NFX CTF 2026 — Sponsored by Linuxenic | National & Campus CTF Competition",
  description = "Portal Resmi NFX CTF 2026 — Kompetisi Capture The Flag nasional & internal kampus (NFCTF × NXCTF). Sponsored by Linuxenic Corp. Hadiah murni didanai sponsor & pihak penyelenggara. Voucher Linuxenic 1 bulan untuk juara 1 setiap track.",
  image = "/og-image.png",
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://nfx.my.id";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageURL = image.startsWith("http") ? image : `${siteUrl}${image.startsWith("/") ? "" : "/"}${image}`;
---

<!doctype html>
<html lang="id" class="reveal-ready">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo2.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="NFX CTF 2026, CTF Indonesia, Capture The Flag, Linuxenic, Linuxenic Corp, NFCTF, NXCTF, UKM NFCC, STT Terpadu Nurul Fikri, Kompetisi Cyber Security, Ethical Hacking"
    />
    <meta name="author" content="UKM NFCC & NXCTF Community" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook / WhatsApp / Telegram / LinkedIn / Discord -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NFX CTF 2026 — Sponsored by Linuxenic Corp." />
    <meta property="og:site_name" content="NFX CTF 2026" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="NFX CTF 2026 — Sponsored by Linuxenic Corp." />

    <!-- Browser & Theme Styling -->
    <meta name="theme-color" content="#020617" />
    <meta name="color-scheme" content="dark" />
  </head>
  <body class="bg-background text-text-primary antialiased selection:bg-nf-orange/35 selection:text-white font-sans">
    <slot />

    <!-- Bidirectional Smooth Scroll Reveal System (Exact NXCTF Architecture) -->
    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const revealTargets = Array.from(document.querySelectorAll("[data-reveal]"));
        const revealGroups = Array.from(document.querySelectorAll("[data-reveal-group]"));

        const show = (element) => element.classList.add("is-visible");
        const hide = (element) => element.classList.remove("is-visible");

        const prepareGroup = (group) => {
          const children = Array.from(group.querySelectorAll("[data-reveal-child]"));
          const baseDelay = Number(group.getAttribute("data-reveal-delay") || 0);
          const stagger = Number(group.getAttribute("data-reveal-stagger") || 90);

          children.forEach((child, index) => {
            child.style.setProperty("--reveal-delay", `${baseDelay + index * stagger}ms`);
          });

          return children;
        };

        const revealGroup = (group) => {
          prepareGroup(group).forEach(show);
        };

        const resetGroup = (group) => {
          group.querySelectorAll("[data-reveal-child]").forEach((child) => {
            child.style.setProperty("--reveal-delay", "0ms");
            hide(child);
          });
        };

        const revealTarget = (target) => {
          if (target.hasAttribute("data-reveal-group")) {
            revealGroup(target);
            return;
          }
          show(target);
        };

        const resetTarget = (target) => {
          if (target.hasAttribute("data-reveal-group")) {
            resetGroup(target);
            return;
          }
          hide(target);
        };

        revealGroups.forEach(prepareGroup);

        if (reduceMotion || !("IntersectionObserver" in window)) {
          revealTargets.forEach(show);
          revealGroups.forEach(revealGroup);
          return;
        }

        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                revealTarget(entry.target);
              } else {
                // Bidirectional: reset when scrolled out of viewport
                resetTarget(entry.target);
              }
            });
          },
          {
            rootMargin: "0px 0px -10% 0px",
            threshold: 0.12,
          }
        );

        revealTargets.forEach((target) => {
          revealObserver.observe(target);
        });

        revealGroups.forEach((group) => {
          revealObserver.observe(group);
        });
      })();
    </script>
  </body>
</html>
