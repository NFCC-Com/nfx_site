---
// Sponsors.astro
import { Star, Coins, Trophy, Handshake, Mail, Check, Heart } from "lucide-react";

// Official Sponsors
const officialSponsors = [
  {
    name: "NF ACADEMY",
    subtitle: "Digital Training Solutions",
    tier: "OFFICIAL SPONSOR",
    tierBadge: "Training & Edu Partner",
    tierColor: "text-amber-300 bg-amber-400/10 border-amber-400/30",
    logo: "/sponsor/nf-academy.png",
    logoClass: "max-h-12 max-w-[220px]",
    desc: "Penyedia solusi pelatihan dan sertifikasi kompetensi digital profesional, mendukung akselerasi talenta IT & cybersecurity Indonesia.",
    highlights: ["Digital Training Solutions", "Official Event Partner NFX CTF 2026"],
  },
  {
    name: "JARVIS",
    subtitle: "Cybersecurity & Technology",
    tier: "OFFICIAL SPONSOR",
    tierBadge: "Technology Partner",
    tierColor: "text-rose-400 bg-rose-500/10 border-rose-500/30",
    logo: "/sponsor/jarvis.png",
    logoClass: "max-h-12 max-w-[170px]",
    desc: "Mitra industri dan teknologi terkemuka yang mendukung ekosistem kompetisi keamanan siber dan infrastruktur NFX CTF 2026.",
    highlights: ["Cybersecurity & Tech Supporter", "Official Event Partner NFX CTF 2026"],
  },
];

// Verified Community Donators
const donators = [
  {
    name: "Anggito Dirgantoro",
    type: "Perorangan",
    amount: "Rp 110.000",
    date: "10 Nov 2026",
    status: "Terverifikasi",
  },
  {
    name: "Alwi Putra Supendi",
    type: "Perorangan",
    amount: "Rp 100.000",
    date: "23 Okt 2026",
    status: "Terverifikasi",
  },
];

// Media Partners & Community Supporters
const mediaPartners = [
  { name: "KTCG Community", logo: "/medpart/ktcg.png", tag: "Medpart Eksternal", bgWhite: false },
  { name: "Campusnet", logo: "/medpart/campusnet.png", tag: "Medpart Eksternal", bgWhite: true },
  { name: "DPM STT-NF", logo: "/medpart/dpm.png", tag: "Medpart Internal", bgWhite: false },
  { name: "HIMA TI STT-NF", logo: "/medpart/himati.png", tag: "Medpart Internal", bgWhite: false },
  { name: "HIMASI STT-NF", logo: "/medpart/himasi.jpeg", tag: "Medpart Internal", bgWhite: true },
  { name: "MUDENG", logo: "/medpart/mudeng.png", tag: "Medpart Internal", bgWhite: false },
  { name: "Forum Perempuan", logo: "/medpart/forum-perempuan.jpeg", tag: "Medpart Internal", bgWhite: true },
];
---

<section id="sponsors" class="py-8 sm:py-10 px-4 sm:px-6 lg:px-8 relative z-10" data-reveal>
  <div class="max-w-5xl mx-auto space-y-4 sm:space-y-5">
    <!-- Section Header (Compact) -->
    <div class="text-center max-w-2xl mx-auto mb-1">
      <div class="inline-flex items-center gap-1.5 font-mono text-[0.68rem] text-amber-400 tracking-widest uppercase mb-1">
        <span>// SPONSORSHIP & PARTNERS //</span>
      </div>
      <h2 class="font-display font-extrabold text-xl sm:text-2xl text-white tracking-tight leading-tight mb-1">
        Sponsor & Partner Resmi
      </h2>
      <p class="text-xs text-text-secondary">
        Didukung oleh platform edukasi cybersecurity, ekosistem open-source, dan institusi akademik nasional.
      </p>
    </div>

    <!-- 1. Official Sponsors Showcase Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-4 w-full items-stretch" data-reveal-group data-reveal-stagger="80">
      {officialSponsors.map((sponsor) => (
        <div data-reveal-child class="p-4 sm:p-5 rounded-xl bg-surface/85 border border-white/15 hover:border-amber-400/40 backdrop-blur-xl shadow-lg flex flex-col justify-between motion-card transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3 pb-2.5 border-b border-white/10">
              <span class={`font-mono text-[0.6rem] font-bold px-2 py-0.5 rounded-full border flex items-center gap-1.5 ${sponsor.tierColor}`}>
                <Star className="size-3 text-amber-300 fill-amber-300/30 shrink-0" />
                <span>{sponsor.tier}</span>
              </span>
              <span class="font-mono text-[0.62rem] text-emerald-400 font-bold bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/25 flex items-center gap-1">
                <Check className="size-2.5 text-emerald-400" />
                <span>{sponsor.tierBadge}</span>
              </span>
            </div>

            <!-- Sponsor Logo Container (High Contrast White Container) -->
            <div class="w-full h-20 rounded-xl bg-white p-3 flex items-center justify-center shadow-md mb-3.5 border border-white/20">
              <img
                src={sponsor.logo}
                alt={`${sponsor.name} Logo`}
                class={`w-full h-full object-contain ${sponsor.logoClass}`}
              />
            </div>

            <div class="flex items-baseline justify-between gap-2 mb-1.5">
              <h3 class="font-display font-bold text-lg sm:text-xl text-white leading-tight">
                {sponsor.name}
              </h3>
              <span class="font-mono text-[0.68rem] text-text-muted truncate">
                {sponsor.subtitle}
              </span>
            </div>

            <p class="text-text-secondary text-xs leading-relaxed mb-3.5">
              {sponsor.desc}
            </p>

            <!-- Highlights -->
            <div class="space-y-1.5 mb-2.5">
              {sponsor.highlights.map((item) => (
                <div class="p-2 rounded-lg bg-surface-elevated/80 border border-white/10 flex items-center gap-2 text-xs text-text-primary">
                  <Check className="size-3.5 text-emerald-400 shrink-0" />
                  <span class="font-display font-medium text-[0.72rem] text-white truncate">{item}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="pt-2.5 border-t border-white/10 font-mono text-[0.62rem] text-text-muted flex items-center justify-between">
            <span class="text-emerald-400 flex items-center gap-1">
              <Check className="size-3" /> Mitra Resmi NFX CTF 2026
            </span>
            <a href="/partnership" class="text-amber-300 hover:underline">Portal Sponsorship ↗</a>
          </div>
        </div>
      ))}
    </div>

    <!-- Partnership & Community Appreciation Banner -->
    <div data-reveal class="p-3.5 sm:p-4 rounded-xl bg-surface/50 border border-amber-400/30 backdrop-blur-md flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-amber-400/10 border border-amber-400/20 text-amber-300 shrink-0 hidden sm:flex">
          <Handshake className="size-4" />
        </div>
        <div>
          <span class="font-display font-bold text-xs sm:text-sm text-white block">
            Apresiasi Kemitraan &amp; Kolaborasi Komunitas
          </span>
          <span class="font-mono text-[0.65rem] text-text-secondary block">
            Terima kasih atas kontribusi luar biasa dari seluruh Sponsor Resmi, Media Partner, dan Donatur Komunitas NFX CTF 2026.
          </span>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a
          href="/partnership"
          class="px-3.5 py-1.5 rounded-lg font-display font-bold text-xs bg-gradient-to-r from-amber-500 to-amber-400 text-slate-950 hover:brightness-110 shadow-sm transition-all whitespace-nowrap"
        >
          Portal Partnership (/partnership) →
        </a>
        <a
          href="https://drive.google.com/drive/folders/1cfvT3gtTWYBw_WcPdvZxbQ57VOailcU8?usp=sharing"
          target="_blank"
          rel="noopener noreferrer"
          class="px-2.5 py-1.5 rounded-lg font-mono text-[0.68rem] bg-white/5 border border-white/10 text-text-secondary hover:text-white transition-colors whitespace-nowrap"
        >
          Drive Proposal ↗
        </a>
      </div>
    </div>

    <!-- 2. Organized & Supported By Grid (Horizontal & Sleek) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-4 w-full" data-reveal-group data-reveal-stagger="80">
      <!-- Organized by: UKM NFCC & NXCTF -->
      <div data-reveal-child class="p-3.5 sm:p-4 rounded-xl bg-surface/75 border border-white/10 backdrop-blur-xl flex flex-col justify-between motion-card">
        <div class="font-mono text-[0.6rem] text-text-muted uppercase tracking-widest mb-2">
          ORGANIZED BY (PENYELENGGARA UTAMA)
        </div>
        <div class="flex items-center justify-around gap-3 py-1">
          <div class="flex items-center gap-2.5">
            <img
              src="/nfcc_black.png"
              alt="UKM NFCC Logo"
              class="size-9 sm:size-10 rounded-xl object-contain shadow-md shadow-black/80 shrink-0"
            />
            <div class="text-left">
              <span class="font-display font-bold text-xs text-white block">UKM NFCC</span>
              <span class="font-mono text-[0.58rem] text-text-muted block">Internal Coordinator</span>
            </div>
          </div>

          <span class="font-mono text-sm font-bold text-nx-purple">✕</span>

          <div class="flex items-center gap-2.5">
            <img
              src="/nxctf-logo.png"
              alt="NXCTF Logo"
              class="size-9 sm:size-10 rounded-xl object-contain shadow-md shadow-black/80 shrink-0"
            />
            <div class="text-left">
              <span class="font-display font-bold text-xs text-white block">NXCTF</span>
              <span class="font-mono text-[0.58rem] text-text-muted block">Platform Partner</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Supported by: STT Terpadu Nurul Fikri -->
      <div data-reveal-child class="p-3.5 sm:p-4 rounded-xl bg-surface/75 border border-white/10 backdrop-blur-xl flex flex-col justify-between motion-card">
        <div class="font-mono text-[0.6rem] text-text-muted uppercase tracking-widest mb-2">
          SUPPORTED BY (ACADEMIC SUPPORTER)
        </div>
        <div class="flex items-center gap-3 py-1">
          <div class="size-9 sm:size-10 rounded-xl bg-white p-1.5 flex items-center justify-center shadow-md shrink-0">
            <img
              src="/sttnf-logo.png"
              alt="STT Terpadu Nurul Fikri Logo"
              class="size-full object-contain"
            />
          </div>
          <div class="text-left min-w-0">
            <span class="font-display font-bold text-xs text-white block truncate">
              STT Terpadu Nurul Fikri
            </span>
            <span class="font-mono text-[0.58rem] text-text-muted block">
              Institusi Pendidikan Tinggi Teknologi & Cybersecurity
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Media Partners & Community Supporters (Compact Grid) -->
    <div class="w-full p-4 sm:p-5 rounded-xl bg-surface/60 border border-white/10 backdrop-blur-xl" data-reveal>
      <div class="flex items-center justify-between gap-3 mb-3.5 pb-2.5 border-b border-white/10">
        <div>
          <div class="font-mono text-[0.6rem] text-nx-cyan font-bold tracking-widest uppercase mb-0.5">
            // MEDIA & COMMUNITY NETWORK //
          </div>
          <h3 class="font-display font-bold text-sm sm:text-base text-white">
            Media Partners & Komunitas Pendukung
          </h3>
        </div>
        <a
          href="/partnership#tab-medpart"
          class="inline-flex items-center gap-1 px-3 py-1 rounded-lg font-mono text-[0.68rem] font-semibold bg-white/5 border border-white/10 text-text-secondary hover:text-nx-cyan hover:border-nx-cyan/40 hover:bg-white/10 transition-all shrink-0"
        >
          <Handshake className="size-3 text-nx-cyan" />
          <span>Gabung Media Partner (/partnership) ↗</span>
        </a>
      </div>

      <!-- Media Partner Cards Grid (Compact) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2.5" data-reveal-group data-reveal-stagger="40">
        {mediaPartners.map((partner) => {
          const isNone = partner.name === "NONE" || partner.isSlot;
          return (
            <div
              data-reveal-child
              class={`p-2.5 rounded-lg flex flex-col items-center justify-center text-center gap-1 motion-card shadow-sm transition-all ${
                isNone
                  ? "bg-surface/30 border border-dashed border-white/10 opacity-60 hover:opacity-90 hover:border-nx-cyan/30"
                  : "bg-surface-elevated/80 border border-white/10 hover:border-nx-cyan/40"
              }`}
            >
              <img
                src={partner.logo}
                alt={partner.name}
                class={`size-9 sm:size-10 rounded-lg object-contain shadow-md group-hover:scale-105 transition-transform ${
                  partner.bgWhite ? "bg-white p-1" : isNone ? "opacity-35 grayscale" : ""
                }`}
              />
              <div class="min-w-0 w-full">
                <span class={`font-display font-bold text-[0.68rem] block truncate ${
                  isNone ? "text-text-muted font-mono tracking-wider" : "text-white"
                }`}>
                  {partner.name}
                </span>
                <span class="font-mono text-[0.55rem] text-text-dim block truncate">
                  {partner.tag}
                </span>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- 4. Community Donatur Scoreboard / Hall of Fame -->
    <div class="w-full p-4 sm:p-5 rounded-xl bg-surface/60 border border-emerald-500/20 backdrop-blur-xl space-y-3.5" data-reveal>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2.5 border-b border-white/10">
        <div>
          <div class="font-mono text-[0.6rem] text-emerald-400 font-bold tracking-widest uppercase mb-0.5 flex items-center gap-1.5">
            <Heart className="size-3 text-emerald-400 fill-emerald-400/30" />
            <span>// DONATUR &amp; COMMUNITY SCOREBOARD //</span>
          </div>
          <h3 class="font-display font-bold text-sm sm:text-base text-white">
            Hall of Fame Donatur Sukarela
          </h3>
          <p class="text-[0.72rem] text-text-secondary">
            Apresiasi resmi untuk donatur sukarela penyokong hadiah dan operasional NFX CTF 2026.
          </p>
        </div>
        <a
          href="/partnership#tab-donatur"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-mono text-[0.68rem] font-bold bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 hover:bg-emerald-500 hover:text-slate-950 transition-all shrink-0 self-start sm:self-auto shadow-sm"
        >
          <Coins className="size-3.5" />
          <span>Berdonasi Mulai 50K (/partnership) ↗</span>
        </a>
      </div>

      <!-- Donatur Leaderboard Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3" data-reveal-group data-reveal-stagger="50">
        {donators.map((donator, idx) => (
          <div
            data-reveal-child
            class="p-3.5 sm:p-4 rounded-xl bg-surface-elevated/90 border border-emerald-500/30 hover:border-emerald-400 transition-all shadow-md flex items-center justify-between gap-3"
          >
            <div class="flex items-center gap-3 min-w-0">
              <div class="size-10 sm:size-11 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-700 text-slate-950 font-display font-black text-sm sm:text-base flex items-center justify-center shadow-md shadow-emerald-500/20 shrink-0">
                #{idx + 1}
              </div>
              <div class="min-w-0">
                <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                  <h4 class="font-display font-bold text-xs sm:text-sm text-white truncate">
                    {donator.name}
                  </h4>
                  <span class="font-mono text-[0.55rem] font-bold px-1.5 py-0.2 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 shrink-0">
                    {donator.type}
                  </span>
                </div>
                <div class="flex items-center gap-2 font-mono text-[0.62rem] text-text-muted">
                  <span>{donator.date}</span>
                  <span>•</span>
                  <span class="text-emerald-400 font-semibold flex items-center gap-0.5">
                    <Check className="size-3 shrink-0" /> {donator.status}
                  </span>
                </div>
              </div>
            </div>

            <div class="text-right shrink-0">
              <span class="font-mono text-[0.58rem] text-text-muted block uppercase">Donasi Sukarela</span>
              <strong class="font-mono text-xs sm:text-sm text-emerald-400 font-extrabold block">
                {donator.amount}
              </strong>
            </div>
          </div>
        ))}

        <!-- Open Donatur Slot Placeholder -->
        <div
          data-reveal-child
          class="p-3.5 sm:p-4 rounded-xl bg-surface/30 border border-dashed border-white/15 hover:border-emerald-500/40 transition-all flex items-center justify-between gap-3 group"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class="size-10 sm:size-11 rounded-xl bg-white/5 border border-white/10 text-text-muted font-display font-bold text-xs flex items-center justify-center shrink-0 group-hover:border-emerald-500/30 group-hover:text-emerald-300 transition-colors">
              +
            </div>
            <div class="min-w-0">
              <span class="font-display font-bold text-xs sm:text-sm text-text-secondary block group-hover:text-white transition-colors truncate">
                Slot Donatur Berikutnya
              </span>
              <span class="font-mono text-[0.62rem] text-text-muted block truncate">
                Dukungan sukarela untuk hadiah peserta CTF
              </span>
            </div>
          </div>
          <a
            href="/partnership#tab-donatur"
            class="font-mono text-[0.65rem] font-bold text-emerald-400 hover:text-emerald-300 hover:underline shrink-0"
          >
            Form Donasi ↗
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
