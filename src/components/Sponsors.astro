---
// Sponsors.astro
import { Star, Coins, Trophy, Handshake, Mail, Check } from "lucide-react";

const officialSponsors = [
  {
    name: "LINUXENIC CORP.",
    tier: "MAIN SPONSOR & RESOURCE PARTNER",
    tierColor: "text-amber-300 bg-amber-400/10 border-amber-400/30",
    desc: "Platform pembelajaran dan pelatihan cybersecurity hands-on lab browser pertama di Indonesia. Mendukung hadiah uang tunai Track Umum serta voucher platform lab untuk Juara 1 setiap track. Rincian hadiah tersedia di guidebook.",
    note: "Sponsorship Dana Tunai Rp 300 Ribu (Bonus Juara 1–3 Umum) + Voucher Akses 1 Bulan Juara 1.",
  },
];

// Media Partners & Community Supporters
const mediaPartners = [
  { name: "KTCG Community", logo: "/ktcg.png", tag: "Media Partner", bgWhite: true },
  { name: "NONE", logo: "/nxctf-logo.png", tag: "Slot Tersedia" },
  { name: "NONE", logo: "/nxctf-logo.png", tag: "Slot Tersedia" },
  { name: "NONE", logo: "/nxctf-logo.png", tag: "Slot Tersedia" },
  { name: "NONE", logo: "/nxctf-logo.png", tag: "Slot Tersedia" },
  { name: "NONE", logo: "/nxctf-logo.png", tag: "Slot Tersedia" },
];
---

<section id="sponsors" class="py-8 sm:py-10 px-4 sm:px-6 lg:px-8 relative z-10" data-reveal>
  <div class="max-w-5xl mx-auto space-y-4 sm:space-y-5">
    <!-- Section Header (Compact) -->
    <div class="text-center max-w-2xl mx-auto mb-1">
      <div class="inline-flex items-center gap-1.5 font-mono text-[0.68rem] text-amber-400 tracking-widest uppercase mb-1">
        <span>// SPONSORSHIP & PARTNERS //</span>
      </div>
      <h2 class="font-display font-extrabold text-xl sm:text-2xl text-white tracking-tight leading-tight mb-1">
        Sponsor & Partner Resmi
      </h2>
      <p class="text-xs text-text-secondary">
        Didukung oleh platform edukasi cybersecurity, ekosistem open-source, dan institusi akademik nasional.
      </p>
    </div>

    <!-- 1. Official Sponsors Grid (Compact & Aligned) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-4 w-full items-stretch" data-reveal-group data-reveal-stagger="80">
      <!-- Active Sponsor: LINUXENIC -->
      {officialSponsors.map((sponsor) => (
        <div data-reveal-child class="p-4 sm:p-5 rounded-xl bg-surface/85 border border-amber-400/30 backdrop-blur-xl shadow-md flex flex-col justify-between motion-card">
          <div>
            <div class="flex items-center gap-3.5 mb-3 pb-2.5 border-b border-white/5">
              <img
                src="/linuxenic-logo.png"
                alt={`${sponsor.name} Logo`}
                class="size-14 sm:size-16 rounded-xl object-contain bg-black border border-amber-400/30 p-2 shadow-lg shrink-0"
              />
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2 mb-1">
                  <span class={`font-mono text-[0.6rem] font-bold px-2 py-0.5 rounded-full border flex items-center gap-1 ${sponsor.tierColor}`}>
                    <Star className="size-3 text-amber-300 fill-amber-300/30 shrink-0" />
                    <span>{sponsor.tier}</span>
                  </span>
                  <a
                    href="https://linuxenic.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[0.65rem] text-nx-cyan hover:underline shrink-0"
                  >
                    linuxenic.com ↗
                  </a>
                </div>
                <h3 class="font-display font-bold text-lg sm:text-xl text-white leading-tight truncate">
                  {sponsor.name}
                </h3>
              </div>
            </div>

            <p class="text-text-secondary text-xs leading-relaxed mb-3">
              {sponsor.desc}
            </p>

            <!-- Reward Pill (Compact 2-item row) -->
            <div class="space-y-1.5 mb-2.5">
              <div class="p-2 rounded-lg bg-surface-elevated/80 border border-amber-400/25 flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 min-w-0">
                  <Coins className="size-4 text-emerald-400 shrink-0" />
                  <span class="font-display font-bold text-[0.72rem] text-white truncate">Sponsorship Cash Prize Pool</span>
                </div>
                <span class="font-mono text-[0.65rem] font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/25 shrink-0">
                  Rp 300.000
                </span>
              </div>
              <div class="p-2 rounded-lg bg-surface-elevated/80 border border-amber-400/20 flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 min-w-0">
                  <Trophy className="size-4 text-amber-300 shrink-0" />
                  <span class="font-display font-bold text-[0.72rem] text-white truncate">Voucher Lab Platform Juara 1</span>
                </div>
                <span class="font-mono text-[0.65rem] font-bold text-amber-300 bg-amber-400/10 px-2 py-0.5 rounded border border-amber-400/25 shrink-0">
                  Akses 1 Bulan
                </span>
              </div>
            </div>
          </div>

          <div class="pt-2 border-t border-white/5 font-mono text-[0.62rem] text-text-muted">
            <span>Voucher lab platform 1 bulan diberikan khusus Juara 1 di masing-masing track.</span>
          </div>
        </div>
      ))}

      <!-- Open Sponsor Slot Card (Compact) -->
      <div data-reveal-child class="p-4 sm:p-5 rounded-xl bg-surface/40 border border-dashed border-white/15 backdrop-blur-xl flex flex-col justify-between motion-card">
        <div>
          <div class="flex items-center justify-between mb-3 pb-2.5 border-b border-white/5">
            <span class="font-mono text-[0.58rem] font-bold px-2 py-0.5 rounded-full bg-nx-cyan/10 border border-nx-cyan/20 text-nx-cyan uppercase flex items-center gap-1">
              <Handshake className="size-3 text-nx-cyan" />
              <span>OPEN FOR SPONSORSHIP</span>
            </span>
            <span class="font-mono text-[0.6rem] text-text-muted">Slot Terbuka</span>
          </div>

          <h3 class="font-display font-bold text-base sm:text-lg text-white mb-1">
            Ingin Menjadi Sponsor Resmi?
          </h3>
          <p class="text-text-secondary text-xs leading-relaxed mb-3">
            Dukung kompetisi CTF nasional dan jangkau ratusan peserta mahasiswa serta praktisi cybersecurity se-Indonesia.
          </p>

          <div class="grid grid-cols-2 gap-1.5 p-2.5 rounded-lg bg-surface/80 border border-white/5 font-mono text-[0.62rem] text-text-muted mb-3">
            <div class="flex items-center gap-1.5 text-text-secondary">
              <Check className="size-3 text-emerald-400 font-bold shrink-0" />
              <span class="truncate">Logo di Web NFX CTF</span>
            </div>
            <div class="flex items-center gap-1.5 text-text-secondary">
              <Check className="size-3 text-emerald-400 font-bold shrink-0" />
              <span class="truncate">Mention Live TM & Media</span>
            </div>
            <div class="flex items-center gap-1.5 text-text-secondary">
              <Check className="size-3 text-emerald-400 font-bold shrink-0" />
              <span class="truncate">Channel Discord NFX</span>
            </div>
            <div class="flex items-center gap-1.5 text-text-secondary">
              <Check className="size-3 text-emerald-400 font-bold shrink-0" />
              <span class="truncate">Eksposur Komunitas Cyber</span>
            </div>
          </div>
        </div>

        <div>
          <a
            href="mailto:nfcc@nurulfikri.ac.id?subject=Inquiry%20Sponsorship%20NFX%20CTF%202026"
            class="inline-flex items-center justify-center gap-1.5 w-full py-2 px-4 rounded-lg font-display font-bold text-xs bg-white/10 hover:bg-nx-cyan hover:text-slate-950 text-white border border-white/10 transition-colors"
          >
            <Mail className="size-3.5" />
            <span>Ajukan Proposal Sponsorship ↗</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 2. Organized & Supported By Grid (Horizontal & Sleek) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-4 w-full" data-reveal-group data-reveal-stagger="80">
      <!-- Organized by: UKM NFCC & NXCTF -->
      <div data-reveal-child class="p-3.5 sm:p-4 rounded-xl bg-surface/75 border border-white/10 backdrop-blur-xl flex flex-col justify-between motion-card">
        <div class="font-mono text-[0.6rem] text-text-muted uppercase tracking-widest mb-2">
          ORGANIZED BY (PENYELENGGARA UTAMA)
        </div>
        <div class="flex items-center justify-around gap-3 py-1">
          <div class="flex items-center gap-2.5">
            <img
              src="/nfcc_black.png"
              alt="UKM NFCC Logo"
              class="size-9 sm:size-10 rounded-xl object-contain shadow-md shadow-black/80 shrink-0"
            />
            <div class="text-left">
              <span class="font-display font-bold text-xs text-white block">UKM NFCC</span>
              <span class="font-mono text-[0.58rem] text-text-muted block">Internal Coordinator</span>
            </div>
          </div>

          <span class="font-mono text-sm font-bold text-nx-purple">✕</span>

          <div class="flex items-center gap-2.5">
            <img
              src="/nxctf-logo.png"
              alt="NXCTF Logo"
              class="size-9 sm:size-10 rounded-xl object-contain shadow-md shadow-black/80 shrink-0"
            />
            <div class="text-left">
              <span class="font-display font-bold text-xs text-white block">NXCTF</span>
              <span class="font-mono text-[0.58rem] text-text-muted block">Platform Partner</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Supported by: STT Terpadu Nurul Fikri -->
      <div data-reveal-child class="p-3.5 sm:p-4 rounded-xl bg-surface/75 border border-white/10 backdrop-blur-xl flex flex-col justify-between motion-card">
        <div class="font-mono text-[0.6rem] text-text-muted uppercase tracking-widest mb-2">
          SUPPORTED BY (ACADEMIC SUPPORTER)
        </div>
        <div class="flex items-center gap-3 py-1">
          <div class="size-9 sm:size-10 rounded-xl bg-white p-1.5 flex items-center justify-center shadow-md shrink-0">
            <img
              src="/sttnf-logo.png"
              alt="STT Terpadu Nurul Fikri Logo"
              class="size-full object-contain"
            />
          </div>
          <div class="text-left min-w-0">
            <span class="font-display font-bold text-xs text-white block truncate">
              STT Terpadu Nurul Fikri
            </span>
            <span class="font-mono text-[0.58rem] text-text-muted block">
              Institusi Pendidikan Tinggi Teknologi & Cybersecurity
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Media Partners & Community Supporters (Compact Grid) -->
    <div class="w-full p-4 sm:p-5 rounded-xl bg-surface/60 border border-white/10 backdrop-blur-xl" data-reveal>
      <div class="flex items-center justify-between gap-3 mb-3.5 pb-2.5 border-b border-white/10">
        <div>
          <div class="font-mono text-[0.6rem] text-nx-cyan font-bold tracking-widest uppercase mb-0.5">
            // MEDIA & COMMUNITY NETWORK //
          </div>
          <h3 class="font-display font-bold text-sm sm:text-base text-white">
            Media Partners & Komunitas Pendukung
          </h3>
        </div>
        <a
          href="mailto:nfcc@nurulfikri.ac.id?subject=Inquiry%20Media%20Partner%20NFX%20CTF%202026"
          class="inline-flex items-center gap-1 px-3 py-1 rounded-lg font-mono text-[0.68rem] font-semibold bg-white/5 border border-white/10 text-text-secondary hover:text-nx-cyan hover:border-nx-cyan/40 hover:bg-white/10 transition-all shrink-0"
        >
          <Handshake className="size-3 text-nx-cyan" />
          <span>Gabung Media Partner ↗</span>
        </a>
      </div>

      <!-- Media Partner Cards Grid (Compact) -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5" data-reveal-group data-reveal-stagger="40">
        {mediaPartners.map((partner) => {
          const isNone = partner.name === "NONE";
          return (
            <div
              data-reveal-child
              class={`p-2.5 rounded-lg flex flex-col items-center justify-center text-center gap-1 motion-card shadow-sm transition-all ${
                isNone
                  ? "bg-surface/30 border border-dashed border-white/10 opacity-60 hover:opacity-90 hover:border-nx-cyan/30"
                  : "bg-surface-elevated/80 border border-white/10 hover:border-nx-cyan/40"
              }`}
            >
              <img
                src={partner.logo}
                alt={partner.name}
                class={`size-9 sm:size-10 rounded-lg object-contain shadow-md group-hover:scale-105 transition-transform ${
                  partner.bgWhite ? "bg-white p-1" : isNone ? "opacity-35 grayscale" : ""
                }`}
              />
              <div class="min-w-0 w-full">
                <span class={`font-display font-bold text-[0.68rem] block truncate ${
                  isNone ? "text-text-muted font-mono tracking-wider" : "text-white"
                }`}>
                  {partner.name}
                </span>
                <span class="font-mono text-[0.55rem] text-text-dim block truncate">
                  {partner.tag}
                </span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
