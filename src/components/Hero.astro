---
import Countdown from "./Countdown";
import { Rocket, BookOpen, MessageSquare, Trophy } from "lucide-react";
---

<section class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-14 px-4 sm:px-6 lg:px-8 overflow-hidden">
  <!-- Centered Ambient Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[420px] bg-gradient-to-tr from-nx-cyan/15 via-nx-purple/15 to-nf-orange/20 blur-[120px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute top-12 left-1/2 -translate-x-1/2 w-96 h-40 bg-nx-cyan/15 blur-[90px] rounded-full pointer-events-none -z-10"></div>

  <div class="relative z-10 max-w-4xl mx-auto text-center flex flex-col items-center">

    <!-- Event Status Badge -->
    <div class="hero-enter inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-surface-elevated/80 border border-emerald-500/30 text-emerald-400 font-mono text-[0.72rem] shadow-[0_0_15px_rgba(16,185,129,0.15)] mb-3">
      <span class="size-2 rounded-full bg-emerald-400"></span>
      <span>07 – 09 NOVEMBER 2026 // EVENT CONCLUDED</span>
    </div>

    <!-- Dual Collab Identifier (High Visibility & Clear Branding) -->
    <div class="hero-enter flex items-center justify-center gap-2.5 font-mono text-xs sm:text-sm md:text-base font-semibold tracking-wider uppercase mb-2">
      <span class="text-nf-orange-bright drop-shadow-[0_0_15px_rgba(255,122,0,0.3)]">NFCTF (UKM NFCC)</span>
      <span class="text-nx-purple font-bold">✕</span>
      <span class="text-nx-cyan drop-shadow-[0_0_15px_rgba(34,211,238,0.3)]">NXCTF COMMUNITY</span>
    </div>

    <!-- Main Title -->
    <h1 class="hero-enter-delay-1 font-display font-extrabold text-4xl sm:text-6xl md:text-7xl text-white tracking-tight leading-[1.08] mb-2.5">
      NFX CTF <span class="text-nf-orange-bright drop-shadow-[0_0_30px_rgba(255,122,0,0.35)]">2026</span>
    </h1>

    <!-- Official Event Sponsors & Partners Badge -->
    <div class="hero-enter-delay-1 inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-surface-elevated/90 border border-white/15 hover:border-amber-400/50 shadow-[0_0_20px_rgba(251,191,36,0.08)] mb-5 backdrop-blur-md transition-all group">
      <span class="size-2 rounded-full bg-amber-400"></span>
      <span class="font-mono text-[0.68rem] text-text-secondary uppercase tracking-wider whitespace-nowrap">
        Official Sponsors: <strong class="text-white">NF ACADEMY</strong> <span class="text-amber-400">✕</span> <strong class="text-white">JARVIS</strong>
      </span>
      <span class="text-white/20">|</span>
      <a href="/#sponsors" class="inline-flex items-center gap-1 font-mono text-[0.68rem] text-amber-300 hover:text-amber-200 transition-colors">
        <span>Mitra &amp; Donatur</span>
        <span class="text-amber-400 text-[0.65rem] group-hover:translate-x-0.5 transition-transform">↓</span>
      </a>
    </div>

    <!-- Subtitle Description -->
    <p class="hero-enter-delay-1 text-sm sm:text-base md:text-lg text-text-secondary max-w-2xl leading-relaxed mb-6">
      Kompetisi <strong class="text-white">Capture The Flag (Individu)</strong> kolaborasi resmi antara <strong class="text-nf-orange-bright">NFCTF (UKM NFCC)</strong> dan <strong class="text-nx-cyan">NXCTF Community</strong>. Jalur pembinaan mahasiswa kampus STT-NF dan ajang persaingan terbuka tingkat nasional.
    </p>

    <!-- 48-Hour Live Countdown -->
    <div class="hero-enter-delay-2 w-full mb-6 max-w-2xl mx-auto">
      <Countdown client:load />
    </div>

    <!-- Action Buttons (Single Clean Line) -->
    <div class="hero-enter-delay-3 flex items-center justify-center gap-2 sm:gap-3 w-full max-w-xl mx-auto mb-5">
      <a
        href="https://ctf.nfx.my.id/scoreboard"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 sm:px-5 py-2.5 sm:py-3 rounded-xl font-display font-bold text-xs bg-gradient-to-r from-nx-cyan via-nx-purple to-nf-orange text-slate-950 shadow-[0_0_20px_rgba(34,211,238,0.3)] hover:scale-[1.02] transition-all flex items-center justify-center gap-1.5 sm:gap-2 whitespace-nowrap shrink-0"
      >
        <Trophy className="size-3.5 sm:size-4 shrink-0" />
        <span>Final Scoreboard</span>
      </a>

      <a
        href="https://ctf.nfx.my.id"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3.5 sm:px-4 py-2.5 sm:py-3 rounded-xl font-display font-semibold text-xs bg-white/5 border border-white/15 text-text-primary hover:border-nx-cyan/50 hover:text-nx-cyan hover:bg-white/10 transition-all backdrop-blur-md flex items-center justify-center gap-1.5 sm:gap-2 whitespace-nowrap shrink-0"
      >
        <Rocket className="size-3.5 sm:size-4 shrink-0" />
        <span>Arena CTF</span>
      </a>

      <a
        href="/guidebook"
        class="px-3.5 sm:px-4 py-2.5 sm:py-3 rounded-xl font-display font-semibold text-xs bg-white/5 border border-white/15 text-text-primary hover:border-nx-cyan/50 hover:text-nx-cyan hover:bg-white/10 transition-all backdrop-blur-md hidden sm:flex items-center justify-center gap-1.5 sm:gap-2 whitespace-nowrap shrink-0"
      >
        <BookOpen className="size-3.5 sm:size-4 shrink-0" />
        <span>Guidebook</span>
      </a>

      <button
        onclick="window.dispatchEvent(new CustomEvent('open-discord-nfx-modal'))"
        class="px-3 sm:px-3.5 py-2.5 sm:py-3 rounded-xl font-mono text-xs font-semibold bg-[#5865F2]/15 border border-[#5865F2]/30 text-[#8ea1e1] hover:bg-[#5865F2] hover:text-white transition-all flex items-center justify-center gap-1.5 sm:gap-2 cursor-pointer whitespace-nowrap shrink-0"
        title="Server Discord NFX CTF"
      >
        <MessageSquare className="size-3.5 sm:size-4 shrink-0" />
        <span>Discord</span>
      </button>
    </div>

    <!-- Telemetry Badges Bar -->
    <div class="hero-enter-delay-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 font-mono text-[0.68rem] text-text-muted">
      <div>FORMAT: <strong class="text-text-secondary">INDIVIDU (SOLO)</strong></div>
      <span>•</span>
      <div>SCORING: <strong class="text-emerald-400">DYNAMIC DECAY</strong></div>
      <span>•</span>
      <div>PLATFORM: <a href="https://ctf.nfx.my.id" target="_blank" rel="noopener noreferrer" class="text-nx-cyan hover:underline">ctf.nfx.my.id ↗</a></div>
    </div>

  </div>
</section>
