---
// Footer.astro
import { Lock, Shield, Zap, Flag } from "lucide-react";
---

<footer class="border-t border-white/10 bg-[#01040d] pt-14 pb-10 px-4 sm:px-6 lg:px-8 relative z-10">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Brand Summary -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-3">
          <img src="/logo2.png" alt="NFX CTF 2026 Logo" class="size-10 object-contain rounded-xl shadow-md" />
          <div class="flex flex-col">
            <div class="flex items-center gap-2">
              <span class="font-display font-black text-xl text-white">NFX CTF</span>
              <span class="font-mono text-[0.65rem] px-1.5 py-0.2 rounded bg-nf-orange/15 text-nf-orange-bright border border-nf-orange/30 font-bold">2026</span>
            </div>
            <span class="font-mono text-[0.65rem] text-text-muted uppercase">NFCTF × NXCTF COLLABORATION</span>
          </div>
        </div>

        <p class="text-text-muted text-xs sm:text-sm leading-relaxed max-w-md mb-5">
          Kompetisi Capture The Flag kolaborasi resmi <strong>NFCTF (UKM NFCC)</strong> dan <strong>NXCTF Community</strong>, didukung oleh <strong>STT Terpadu Nurul Fikri</strong>, serta disponsori oleh <strong>LINUXENIC CORP.</strong>
        </p>

        <!-- Social Icons -->
        <div class="flex items-center gap-2.5 flex-wrap">
          <!-- Discord NFX CTF Modal Trigger -->
          <button
            onclick="window.dispatchEvent(new CustomEvent('open-discord-nfx-modal'))"
            class="p-2 rounded-xl bg-[#5865F2]/15 border border-[#5865F2]/30 text-[#8ea1e1] hover:bg-[#5865F2] hover:text-white transition-colors cursor-pointer"
            title="Discord NFX CTF (Peserta)"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          </button>

          <!-- Instagram NFCC -->
          <a
            href="https://instagram.com/nfcc.id"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-xl bg-white/5 border border-white/10 text-text-secondary hover:text-nf-orange hover:border-nf-orange/40 transition-colors"
            title="Instagram NFCC"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>

          <!-- GitHub NFCC -->
          <a
            href="https://github.com/NFCC-Com"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-xl bg-white/5 border border-white/10 text-text-secondary hover:text-white hover:border-white/30 transition-colors"
            title="GitHub NFCC"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>

          <!-- GitHub NXCTF -->
          <a
            href="https://github.com/nxctf"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-xl bg-white/5 border border-white/10 text-text-secondary hover:text-nx-cyan hover:border-nx-cyan/40 transition-colors"
            title="GitHub NXCTF"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Nav -->
      <div>
        <h4 class="font-mono text-xs font-bold text-white uppercase tracking-wider mb-3">Navigasi</h4>
        <ul class="space-y-2 text-xs font-mono text-text-muted">
          <li><a href="/#about" class="hover:text-nx-cyan transition-colors">Tentang Kolaborasi</a></li>
          <li><a href="/#tracks" class="hover:text-nx-cyan transition-colors">Track & Hadiah</a></li>
          <li><a href="/#categories" class="hover:text-nx-cyan transition-colors">8 Kategori Soal</a></li>
          <li><a href="/#timeline" class="hover:text-nx-cyan transition-colors">Timeline Lomba</a></li>
          <li><a href="/#rules" class="hover:text-nx-cyan transition-colors">Regulasi & Writeup</a></li>
          <li><a href="/partnership" class="hover:text-amber-300 text-amber-400 font-semibold transition-colors">Partnership, Sponsor &amp; Donasi (/partnership)</a></li>
          <li><a href="https://drive.google.com/drive/folders/1cfvT3gtTWYBw_WcPdvZxbQ57VOailcU8?usp=sharing" target="_blank" rel="noopener noreferrer" class="hover:text-nx-cyan text-text-muted transition-colors">Proposal Google Drive ↗</a></li>
        </ul>
      </div>

      <!-- Discord & Platform Channels -->
      <div>
        <h4 class="font-mono text-xs font-bold text-white uppercase tracking-wider mb-3">Channel Discord</h4>
        <ul class="space-y-2 text-xs font-mono text-text-muted">
          <li>
            <button
              onclick="window.dispatchEvent(new CustomEvent('open-discord-nfx-modal'))"
              class="hover:text-nx-cyan transition-colors flex items-center gap-1.5 text-left cursor-pointer"
            >
              <Lock className="size-3 text-amber-300 shrink-0" />
              <span>Discord NFX CTF (Peserta)</span>
            </button>
          </li>
          <li>
            <a href="https://discord.gg/q8gxeYZgMC" target="_blank" rel="noopener noreferrer" class="hover:text-nf-orange transition-colors flex items-center gap-1.5">
              <Shield className="size-3 text-nf-orange shrink-0" />
              <span>Discord NFCC (Publik)</span>
            </a>
          </li>
          <li>
            <a href="https://discord.gg/5etKks6aQQ" target="_blank" rel="noopener noreferrer" class="hover:text-nx-cyan transition-colors flex items-center gap-1.5">
              <Zap className="size-3 text-nx-cyan shrink-0" />
              <span>Discord NXCTF (Publik)</span>
            </a>
          </li>
          <li class="pt-1.5 border-t border-white/5">
            <a href="https://ctf.nfx.my.id" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors flex items-center gap-1.5 text-emerald-400">
              <Flag className="size-3 text-emerald-400 shrink-0" />
              <span>ctf.nfx.my.id ↗</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 font-mono text-[0.68rem] text-text-dim">
      <span>© 2026 NFX CTF. Diselenggarakan oleh UKM NFCC & NXCTF Community • Sponsored by LINUXENIC CORP.</span>
      <span>STT Terpadu Nurul Fikri</span>
    </div>
  </div>
</footer>
