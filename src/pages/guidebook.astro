---
import Layout from "../layouts/Layout.astro";
import BackgroundCanvas from "../components/BackgroundCanvas";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Guidebook Teknis — NFX CTF 2026 | Panduan Resmi Kompetisi">
  <BackgroundCanvas client:load />
  <Header />

  <main class="relative z-10 pt-28 pb-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
    <!-- Top Doc Header -->
    <div class="mb-10 pb-6 border-b border-white/10 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 font-mono text-xs text-text-muted mb-2">
          <a href="/" class="hover:text-nx-cyan transition-colors">Portal Beranda</a>
          <span>/</span>
          <span class="text-white">Dokumentasi</span>
          <span>/</span>
          <span class="text-nx-cyan">Guidebook 2026</span>
        </div>
        <h1 class="font-display font-black text-2xl sm:text-4xl text-white tracking-tight">
          Official Guidebook NFX CTF 2026
        </h1>
        <p class="text-sm text-text-secondary mt-1 max-w-2xl">
          Dokumentasi teknis, regulasi perlombaan, scoring platform NXCTF, serta pedoman penulisan writeup.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a
          href="https://ctf.nfx.my.id"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl font-mono text-xs font-bold bg-nx-cyan text-slate-950 hover:bg-cyan-300 transition-all shadow-md shadow-nx-cyan/20"
        >
          <span>Server Platform NXCTF</span>
          <span>↗</span>
        </a>
      </div>
    </div>

    <!-- Docs Layout: Sticky Clean Nav + Reading Column -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <!-- Left Sidebar Navigation -->
      <aside class="hidden lg:block lg:col-span-3">
        <div class="sticky top-24 space-y-6">
          <div>
            <div class="font-mono text-[0.68rem] font-bold text-text-muted uppercase tracking-wider mb-2.5 px-2">
              Daftar Isi
            </div>
            <nav class="space-y-0.5 font-mono text-xs text-text-secondary">
              <a href="#informasi-umum" class="block py-1.5 px-2.5 rounded-lg hover:text-white hover:bg-white/5 transition-colors">
                Informasi Umum
              </a>
              <a href="#track-biaya" class="block py-1.5 px-2.5 rounded-lg hover:text-white hover:bg-white/5 transition-colors">
                Track & Biaya Registrasi
              </a>
              <a href="#platform-scoring" class="block py-1.5 px-2.5 rounded-lg hover:text-white hover:bg-white/5 transition-colors">
                Platform & Scoring
              </a>
              <a href="#format-flag" class="block py-1.5 px-2.5 rounded-lg hover:text-white hover:bg-white/5 transition-colors">
                Standar Format Flag
              </a>
              <a href="#pedoman-writeup" class="block py-1.5 px-2.5 rounded-lg hover:text-white hover:bg-white/5 transition-colors">
                Pedoman Writeup (WU)
              </a>
              <a href="#hadiah-sponsor" class="block py-1.5 px-2.5 rounded-lg hover:text-white hover:bg-white/5 transition-colors">
                Skema Hadiah & Sponsor
              </a>
              <a href="#kode-etik" class="block py-1.5 px-2.5 rounded-lg hover:text-white hover:bg-white/5 transition-colors">
                Kode Etik & Kebijakan AI
              </a>
              <a href="#helpdesk" class="block py-1.5 px-2.5 rounded-lg hover:text-white hover:bg-white/5 transition-colors">
                Narahubung Resmi
              </a>
            </nav>
          </div>

          <div class="p-3.5 rounded-xl bg-surface border border-white/10 font-mono text-[0.72rem] space-y-2">
            <span class="text-text-muted block text-[0.65rem] uppercase">Official Community:</span>
            <a href="https://discord.gg/q8gxeYZgMC" target="_blank" rel="noopener noreferrer" class="text-nx-cyan hover:underline block">
              💬 Discord UKM NFCC
            </a>
            <a href="https://discord.gg/5etKks6aQQ" target="_blank" rel="noopener noreferrer" class="text-nx-purple hover:underline block">
              💬 Discord NXCTF
            </a>
          </div>
        </div>
      </aside>

      <!-- Right Main Documentation Body (Clean Developer Prose) -->
      <div class="lg:col-span-9 space-y-12 text-text-secondary text-sm leading-relaxed">

        <!-- 1. Informasi Umum -->
        <section id="informasi-umum" class="scroll-mt-24 space-y-5">
          <div class="flex items-center gap-2 text-white">
            <h2 class="font-display font-bold text-xl sm:text-2xl text-white">
              1. Informasi Umum, Latar Belakang & Format Kompetisi
            </h2>
          </div>

          <p>
            <strong>NFX CTF 2026</strong> adalah ajang kompetisi keamanan siber (*Capture The Flag*) kolaborasi resmi antara divisi kompetisi <strong>UKM NFCC (Nurul Fikri Cyber Security Community)</strong> dan <strong>NXCTF Community</strong>, dengan dukungan penuh dari institusi perguruan tinggi <strong>STT Terpadu Nurul Fikri</strong>.
          </p>

          <!-- Story / Latar Belakang Inisiasi (Singkat & Ringkas) -->
          <div class="p-3.5 sm:p-4 rounded-xl bg-surface/90 border border-white/10 space-y-2 shadow-md">
            <div class="flex items-center justify-between pb-1.5 border-b border-white/5">
              <div class="flex items-center gap-2">
                <span class="text-sm">🚀</span>
                <h3 class="font-display font-bold text-xs sm:text-sm text-white">
                  Latar Belakang: NFCTF Season 1 ➔ NFX CTF 2026
                </h3>
              </div>
              <span class="font-mono text-[0.6rem] font-bold px-2 py-0.5 rounded bg-nf-orange/15 text-nf-orange-bright border border-nf-orange/30">
                ASAL-USUL
              </span>
            </div>

            <p class="text-xs text-text-secondary leading-relaxed">
              Kompetisi ini berawal dari program kerja internal divisi kompetisi UKM NFCC bernama <strong>NFCTF Season 1</strong> sebagai wadah latihan praktis mahasiswa STT-NF. Konsep ini kemudian dikembangkan lebih luas melalui kolaborasi bersama <strong>NXCTF Community</strong> menjadi ajang nasional <strong>NFX CTF 2026</strong> (Track Mahasiswa & Track Umum), serta didukung penuh oleh <strong>LINUXENIC CORP.</strong> sebagai sponsor utama reward.
            </p>
          </div>

          <!-- Parameter Pelaksanaan & URL Platform -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="p-3.5 rounded-xl bg-surface border border-white/10 font-mono text-xs space-y-1">
              <span class="text-text-muted block text-[0.65rem] uppercase">WAKTU & FORMAT:</span>
              <strong class="text-white block text-sm">Jeopardy CTF (48 Jam Non-stop)</strong>
              <span class="text-text-secondary text-[0.7rem] block">07 – 09 November 2026 (14:00 WIB – 14:00 WIB)</span>
            </div>
            <div class="p-3.5 rounded-xl bg-surface border border-nx-cyan/30 font-mono text-xs space-y-1">
              <span class="text-text-muted block text-[0.65rem] uppercase">URL RESMI PLATFORM:</span>
              <a href="https://ctf.nfx.my.id" target="_blank" rel="noopener noreferrer" class="text-nx-cyan font-bold block text-sm hover:underline">
                https://ctf.nfx.my.id ↗
              </a>
              <span class="text-text-secondary text-[0.7rem] block">Dynamic Scoring & Automated Flag Validation</span>
            </div>
          </div>

          <!-- 8 Kategori Soal (Desain Rapi & Grid Terstruktur) -->
          <div class="space-y-2 pt-1">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs text-white font-bold">// 8 KATEGORI TANTANGAN RESMI //</span>
              <span class="font-mono text-[0.62rem] text-text-muted">Tingkat Kesulitan: Beginner s/d Intermediate</span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 font-mono text-xs">
              <div class="p-2.5 rounded-lg bg-surface border border-white/5 hover:border-nx-cyan/30 transition-colors">
                <div class="text-base mb-1">🌐</div>
                <strong class="text-white text-xs block">Web Exploitation</strong>
                <span class="text-text-muted text-[0.62rem]">SQLi, XSS, SSRF, Auth Bypass</span>
              </div>
              <div class="p-2.5 rounded-lg bg-surface border border-white/5 hover:border-nx-cyan/30 transition-colors">
                <div class="text-base mb-1">⚙️</div>
                <strong class="text-white text-xs block">Binary Exploit (Pwn)</strong>
                <span class="text-text-muted text-[0.62rem]">Buffer Overflow, ROP, Format Str</span>
              </div>
              <div class="p-2.5 rounded-lg bg-surface border border-white/5 hover:border-nx-cyan/30 transition-colors">
                <div class="text-base mb-1">🔄</div>
                <strong class="text-white text-xs block">Reverse Engineering</strong>
                <span class="text-text-muted text-[0.62rem]">Decompilation, Assembly, Patching</span>
              </div>
              <div class="p-2.5 rounded-lg bg-surface border border-white/5 hover:border-nx-cyan/30 transition-colors">
                <div class="text-base mb-1">🔐</div>
                <strong class="text-white text-xs block">Cryptography</strong>
                <span class="text-text-muted text-[0.62rem]">RSA, Classical Cipher, ECC, XOR</span>
              </div>
              <div class="p-2.5 rounded-lg bg-surface border border-white/5 hover:border-nx-cyan/30 transition-colors">
                <div class="text-base mb-1">🔍</div>
                <strong class="text-white text-xs block">Digital Forensics</strong>
                <span class="text-text-muted text-[0.62rem]">PCAP, Memory Dump, Stego, Disk</span>
              </div>
              <div class="p-2.5 rounded-lg bg-surface border border-white/5 hover:border-nx-cyan/30 transition-colors">
                <div class="text-base mb-1">🛰️</div>
                <strong class="text-white text-xs block">OSINT</strong>
                <span class="text-text-muted text-[0.62rem]">Geolocation, SOCMINT, Footprinting</span>
              </div>
              <div class="p-2.5 rounded-lg bg-surface border border-white/5 hover:border-nx-cyan/30 transition-colors">
                <div class="text-base mb-1">💻</div>
                <strong class="text-white text-xs block">Boot to Root</strong>
                <span class="text-text-muted text-[0.62rem]">SSH Port-Forwarding, Priv-Esc</span>
              </div>
              <div class="p-2.5 rounded-lg bg-surface border border-white/5 hover:border-nx-cyan/30 transition-colors">
                <div class="text-base mb-1">🧩</div>
                <strong class="text-white text-xs block">Miscellaneous</strong>
                <span class="text-text-muted text-[0.62rem]">Esoteric Lang, Logic, Jailbreak</span>
              </div>
            </div>
          </div>
        </section>

        <hr class="border-white/10" />

        <!-- 2. Track & Biaya Registrasi -->
        <section id="track-biaya" class="scroll-mt-24 space-y-4">
          <h2 class="font-display font-bold text-xl sm:text-2xl text-white">
            2. Jalur Partisipasi (Track) & Biaya Registrasi
          </h2>
          <p>
            Peserta dapat mendaftar melalui salah satu dari 2 jalur resmi:
          </p>

          <div class="overflow-x-auto rounded-xl border border-white/10 bg-surface shadow-md">
            <table class="w-full text-left font-mono text-xs">
              <thead class="bg-white/5 border-b border-white/10 text-text-muted">
                <tr>
                  <th class="p-3 font-bold text-white">Parameter</th>
                  <th class="p-3 text-nf-orange-bright font-bold">Track Mahasiswa NF</th>
                  <th class="p-3 text-nx-cyan font-bold">Track Umum (Nasional)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="p-3 font-semibold text-white">Eligibility</td>
                  <td class="p-3 text-text-secondary">Mahasiswa Aktif STT-NF</td>
                  <td class="p-3 text-text-secondary">Terbuka Nasional (Pelajar, Mahasiswa, Praktisi)</td>
                </tr>
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="p-3 font-semibold text-white">Biaya (HTM)</td>
                  <td class="p-3"><span class="px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 font-bold border border-emerald-500/30">100% Gratis</span></td>
                  <td class="p-3"><span class="px-2 py-0.5 rounded bg-nx-cyan/15 text-nx-cyan font-bold border border-nx-cyan/30">Rp 10.000,- (Flat)</span></td>
                </tr>
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="p-3 font-semibold text-white">Workshop Tambahan</td>
                  <td class="p-3 text-white font-medium">2x Workshop (1 Online, 1 Offline)</td>
                  <td class="p-3 text-text-muted">Technical Meeting & Helpdesk</td>
                </tr>
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="p-3 font-semibold text-white">Sertifikat Peserta</td>
                  <td class="p-3 text-emerald-400">E-Certificate Resmi (Otomatis)</td>
                  <td class="p-3 text-nx-cyan">E-Certificate Resmi (Validasi Writeup)</td>
                </tr>
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="p-3 font-semibold text-white">Alokasi Hadiah</td>
                  <td class="p-3 text-amber-300 font-semibold">Fixed Cash Rp 400.000 (Top 5) + Voucher</td>
                  <td class="p-3 text-emerald-400 font-semibold">Rp 1 Juta (Sponsor) + 90% Pool + Voucher</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <hr class="border-white/10" />

        <!-- 3. Platform & Scoring -->
        <section id="platform-scoring" class="scroll-mt-24 space-y-4">
          <h2 class="font-display font-bold text-xl sm:text-2xl text-white">
            3. Platform NXCTF & Mekanisme Scoring
          </h2>
          <p>
            Kompetisi berjalan pada infrastruktur <strong>Platform NXCTF</strong> yang menerapkan <strong>Dynamic Scoring Engine</strong>:
          </p>

          <ul class="list-disc list-inside space-y-1.5 pl-1">
            <li>Setiap challenge dibuka dengan nilai awal maksimal <strong>500 Poin</strong>.</li>
            <li>Nilai soal meluruh (*decay*) secara dinamis dengan parameter decay <strong>20 Solver</strong> hingga mencapai batas minimum <strong>100 Poin</strong>.</li>
            <li>Skor seluruh solver sebelumnya akan diperbarui otomatis secara proporsional merefleksikan tingkat kesulitan soal.</li>
            <li>Tie-breaker penentu peringkat jika poin sama dihitung berdasarkan waktu submission flag tercepat.</li>
          </ul>

          <div class="p-4 rounded-xl bg-surface border-l-2 border-nx-cyan space-y-1">
            <span class="font-mono text-xs text-nx-cyan font-bold block">Distribusi Kredensial Akun:</span>
            <p class="text-xs text-text-secondary">
              Akun peserta (Username & Password) dan link Discord resmi akan dikirimkan otomatis ke <strong>Email Terdaftar</strong> pada <strong>H-1 Technical Meeting (03 Nov 2026)</strong> atau <strong>H-1 Lomba (06 Nov 2026)</strong>.
            </p>
          </div>
        </section>

        <hr class="border-white/10" />

        <!-- 4. Format Flag -->
        <section id="format-flag" class="scroll-mt-24 space-y-3">
          <h2 class="font-display font-bold text-xl sm:text-2xl text-white">
            4. Standar Format Flag
          </h2>
          <p>
            Setiap flag jawaban yang berhasil didapatkan dibungkus dengan format resmi case-sensitive:
          </p>

          <div class="p-3.5 rounded-xl bg-black border border-nx-cyan/30 flex items-center justify-between font-mono text-sm shadow-inner">
            <span class="text-nx-cyan font-bold select-all tracking-wider">NFX&#123;your_flag_here&#125;</span>
            <span class="text-[0.65rem] font-bold text-text-muted uppercase px-2 py-0.5 rounded bg-white/5 border border-white/10">CASE-SENSITIVE</span>
          </div>

          <p class="text-xs text-text-muted">
            Harap masukkan string lengkap termasuk pembungkus <code class="text-amber-300 font-mono">NFX&#123;</code> dan penutup <code class="text-amber-300 font-mono">&#125;</code> tanpa spasi tambahan.
          </p>
        </section>

        <hr class="border-white/10" />

        <!-- 5. Pedoman Writeup -->
        <section id="pedoman-writeup" class="scroll-mt-24 space-y-4">
          <h2 class="font-display font-bold text-xl sm:text-2xl text-white">
            5. Pedoman Penulisan Writeup (WU)
          </h2>
          <p>
            Writeup adalah laporan bukti penyelesaian challenge bagi peserta. Dokumen dikumpulkan dalam format <strong>PDF</strong> atau link <strong>GitHub / Markdown</strong> maksimal 24 jam setelah kompetisi berakhir.
          </p>

          <div class="p-4 rounded-xl bg-surface border border-white/10 space-y-3">
            <span class="font-mono text-xs text-nx-cyan font-bold block">// FORMAT PRAKTIS STRUKTUR WRITEUP //</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 font-mono text-xs text-text-secondary">
              <div class="p-2.5 rounded-lg bg-background/80 border border-white/5 flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0">01.</span>
                <div>
                  <strong class="text-white block">Username & Akun CTF</strong>
                  <span class="text-text-muted text-[0.68rem]">Nama/Username dan Username di platform CTF</span>
                </div>
              </div>
              <div class="p-2.5 rounded-lg bg-background/80 border border-white/5 flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0">02.</span>
                <div>
                  <strong class="text-white block">Foto Scoreboard</strong>
                  <span class="text-text-muted text-[0.68rem]">Screenshot bukti peringkat & total poin akhir</span>
                </div>
              </div>
              <div class="p-2.5 rounded-lg bg-background/80 border border-white/5 flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0">03.</span>
                <div>
                  <strong class="text-white block">Analisa Solver & PoC</strong>
                  <span class="text-text-muted text-[0.68rem]">Langkah exploit, command terminal, atau script solver</span>
                </div>
              </div>
              <div class="p-2.5 rounded-lg bg-background/80 border border-white/5 flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0">04.</span>
                <div>
                  <strong class="text-white block">Flag</strong>
                  <span class="text-text-muted text-[0.68rem]">String flag lengkap yang didapatkan (NFX&#123;...&#125;)</span>
                </div>
              </div>
              <div class="p-2.5 rounded-lg bg-background/80 border border-white/5 flex items-start gap-2.5 sm:col-span-2">
                <span class="text-emerald-400 font-bold shrink-0">05.</span>
                <div>
                  <strong class="text-white block">Transparansi AI</strong>
                  <span class="text-text-muted text-[0.68rem]">Keterangan terbuka jika/bagaimana tools/asisten AI (ChatGPT/Gemini/Claude) digunakan</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <hr class="border-white/10" />

        <!-- 6. Hadiah & Sponsor -->
        <section id="hadiah-sponsor" class="scroll-mt-24 space-y-3">
          <h2 class="font-display font-bold text-xl sm:text-2xl text-white">
            6. Skema Hadiah & Sponsor
          </h2>
          <p class="text-xs text-text-secondary">
            Alokasi hadiah pemenang terverifikasi di masing-masing track dengan dukungan sponsorship dan dynamic pool:
          </p>

          <!-- Explanation Box for Track Umum Prize Structure -->
          <div class="p-3.5 rounded-xl bg-surface border border-nx-cyan/30 space-y-2 font-mono text-xs">
            <div class="flex items-center gap-2 text-nx-cyan font-bold text-xs sm:text-sm">
              <span>💰</span>
              <span>Struktur Hadiah Track Umum (Nasional):</span>
            </div>
            <p class="text-text-secondary leading-relaxed text-[0.72rem]">
              Total Prize Pool Track Umum merupakan gabungan dari <strong>Dana Tunai Sponsorship Rp 1.000.000</strong> (didukung penuh oleh Main Sponsor <strong>LINUXENIC CORP.</strong>) ditambah akumulasi <strong>90% uang tiket registrasi</strong> seluruh peserta (@ Rp 10.000/peserta).
            </p>
            <div class="p-2.5 rounded-lg bg-black/60 border border-white/10 text-white font-bold text-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-1.5">
              <span class="text-text-muted text-[0.68rem]">Rumus Total Hadiah:</span>
              <span class="text-emerald-400 font-mono text-xs sm:text-sm">Rp 1.000.000 (Sponsor) + (Peserta × Rp 9.000)</span>
            </div>
          </div>

          <div class="overflow-x-auto rounded-xl border border-white/10 bg-surface shadow-md">
            <table class="w-full text-left font-mono text-xs">
              <thead class="bg-white/5 border-b border-white/10 text-text-muted">
                <tr>
                  <th class="p-3 font-bold text-white">Peringkat</th>
                  <th class="p-3 text-nf-orange-bright font-bold">Track Mahasiswa NF (Fixed Rp400k)</th>
                  <th class="p-3 text-nx-cyan font-bold">Track Umum (Rp 1 Jt Sponsor + 90% Pool)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5 text-[0.72rem]">
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="p-3 font-bold text-amber-300 flex items-center gap-1.5">
                    <span class="text-base">🥇</span>
                    <span>Juara 1</span>
                  </td>
                  <td class="p-3">
                    <strong class="text-white">Rp 150.000</strong>
                    <span class="text-text-muted block text-[0.65rem]">+ Voucher LINUXENIC 1 Bulan</span>
                  </td>
                  <td class="p-3">
                    <strong class="text-emerald-400 font-bold">50% Total Pool</strong>
                    <span class="text-text-muted block text-[0.65rem]">+ Voucher LINUXENIC 1 Bulan</span>
                  </td>
                </tr>
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="p-3 font-bold text-slate-300 flex items-center gap-1.5">
                    <span class="text-base">🥈</span>
                    <span>Juara 2</span>
                  </td>
                  <td class="p-3">
                    <strong class="text-white">Rp 100.000</strong>
                  </td>
                  <td class="p-3">
                    <strong class="text-nx-cyan font-bold">30% Total Pool</strong>
                  </td>
                </tr>
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="p-3 font-bold text-amber-500 flex items-center gap-1.5">
                    <span class="text-base">🥉</span>
                    <span>Juara 3</span>
                  </td>
                  <td class="p-3">
                    <strong class="text-white">Rp 50.000</strong>
                  </td>
                  <td class="p-3">
                    <strong class="text-nx-cyan font-bold">20% Total Pool</strong>
                  </td>
                </tr>
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="p-3 text-text-muted flex items-center gap-1.5">
                    <span class="text-base">🎖️</span>
                    <span>Juara 4</span>
                  </td>
