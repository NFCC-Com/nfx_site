---
import CertificatePolicy from "../components/CertificatePolicy";
import Layout from "../layouts/Layout.astro";
import BackgroundCanvas from "../components/BackgroundCanvas";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DiscordNfxModal from "../components/DiscordNfxModal";
import RegisterModal from "../components/RegisterModal";
import {
  Globe,
  Cpu,
  Binary,
  KeyRound,
  Search,
  Compass,
  Terminal,
  Puzzle,
  FileText,
  Scale,
  Flag,
  Trophy,
  Coins,
  Check,
  X,
  Clock,
  ExternalLink,
  MessageSquare,
  Ticket,
  BookOpen,
  ArrowRight,
  List,
} from "lucide-react";

const disciplines = [
  {
    name: "Web Exploitation",
    Icon: Globe,
    color: "text-nx-cyan bg-nx-cyan/10 border-nx-cyan/25",
    desc: "SQLi, XSS, SSRF, IDOR, bypass otentikasi server",
  },
  {
    name: "Binary Exploit (Pwn)",
    Icon: Cpu,
    color: "text-rose-400 bg-rose-500/10 border-rose-500/25",
    desc: "Buffer overflow, ROP chain, format string, shellcoding",
  },
  {
    name: "Reverse Engineering",
    Icon: Binary,
    color: "text-nx-purple bg-nx-purple/10 border-nx-purple/25",
    desc: "Decompilation biner, x86/ARM assembly, bypass logic",
  },
  {
    name: "Cryptography",
    Icon: KeyRound,
    color: "text-emerald-400 bg-emerald-500/10 border-emerald-500/25",
    desc: "RSA math exploit, classical cipher, hash collision, ECC",
  },
  {
    name: "Digital Forensics",
    Icon: Search,
    color: "text-blue-400 bg-blue-500/10 border-blue-500/25",
    desc: "Analisis PCAP network, memory dump, steganografi, disk",
  },
  {
    name: "OSINT (Intelligence)",
    Icon: Compass,
    color: "text-amber-400 bg-amber-500/10 border-amber-400/25",
    desc: "Geolocation, SOCMINT, public footprinting, intel analysis",
  },
  {
    name: "Boot to Root",
    Icon: Terminal,
    color: "text-nf-orange-bright bg-nf-orange/10 border-nf-orange/25",
    desc: "SSH port-forwarding, Linux/Windows privilege escalation",
  },
  {
    name: "Miscellaneous & Logic",
    Icon: Puzzle,
    color: "text-pink-400 bg-pink-500/10 border-pink-500/25",
    desc: "Python scripting, sandbox escape, esoteric code, logika",
  },
];

const tocItems = [
  { id: "informasi-umum", num: "01", title: "Informasi & Format" },
  { id: "kategori-soal", num: "02", title: "8 Kategori Soal" },
  { id: "track-biaya", num: "03", title: "Jalur & Biaya" },
  { id: "platform-scoring", num: "04", title: "Platform & Scoring" },
  { id: "format-flag", num: "05", title: "Format Flag" },
  { id: "pedoman-writeup", num: "06", title: "Panduan Writeup" },
  { id: "hadiah-sponsor", num: "07", title: "Hadiah & Sponsor" },
  { id: "kode-etik", num: "08", title: "Kode Etik & AI" },
  { id: "helpdesk", num: "09", title: "Narahubung & Bantuan" },
];
---

<Layout
  title="Guidebook Teknis — NFX CTF 2026 (Sponsored by Linuxenic) | Panduan Resmi"
  description="Dokumentasi teknis, regulasi perlombaan, scoring platform NXCTF, serta pedoman penulisan writeup NFX CTF 2026."
>
  <BackgroundCanvas client:load />
  <Header />

  <main class="relative z-10 pt-24 pb-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
    <!-- Mobile Table of Contents Dropdown (Convenient on Phones) -->
    <div class="lg:hidden mb-6">
      <details class="group p-3.5 rounded-2xl bg-surface-elevated/90 border border-white/10 backdrop-blur-md">
        <summary class="flex items-center justify-between font-mono text-xs font-bold text-white cursor-pointer select-none">
          <span class="flex items-center gap-2">
            <List className="size-4 text-nx-cyan" />
            <span>DAFTAR ISI GUIDEBOOK</span>
          </span>
          <span class="text-text-muted group-open:rotate-180 transition-transform text-xs">▼</span>
        </summary>
        <nav class="pt-2.5 mt-2.5 border-t border-white/5 flex flex-col gap-1 font-mono text-xs">
          {tocItems.map((item) => (
            <a
              href={`#${item.id}`}
              class="py-1.5 px-2 rounded-lg text-text-secondary hover:text-white hover:bg-white/5 transition-colors flex items-center justify-between"
            >
              <span>{item.num}. {item.title}</span>
              <span class="text-text-muted text-[0.65rem]">→</span>
            </a>
          ))}
        </nav>
      </details>
    </div>

    <!-- 2-Column Layout: Permanent Sticky Sidebar (Left) + Guidebook Body (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

      <!-- Permanent Sticky Desktop Table of Contents (Pure Guidebook Content) -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24 self-start max-h-[calc(100vh-7rem)] overflow-y-auto no-scrollbar">
        <div class="p-4 rounded-2xl bg-surface/80 border border-white/10 backdrop-blur-xl shadow-lg">
          <div class="pb-2.5 border-b border-white/10 mb-2">
            <span class="font-mono text-xs font-bold text-white flex items-center gap-1.5">
              <List className="size-3.5 text-nx-cyan" />
              <span>DAFTAR ISI</span>
            </span>
          </div>
          <nav class="space-y-0.5 font-mono text-xs" id="desktop-toc">
            {tocItems.map((item) => (
              <a
                href={`#${item.id}`}
                class="toc-link block py-1.5 px-2.5 rounded-lg text-text-secondary hover:text-white hover:bg-white/5 transition-all text-xs"
              >
                <span class="text-text-muted mr-1.5 text-[0.68rem]">{item.num}.</span>
                <span>{item.title}</span>
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Main Reading Column (Clean Blog / Modern Technical Prose) -->
      <div class="lg:col-span-9 space-y-14 text-text-secondary text-sm sm:text-base leading-relaxed">

        <!-- 01. Informasi Umum -->
        <section id="informasi-umum" class="scroll-mt-24 space-y-4">
          <div class="pb-2 border-b border-white/10">
            <span class="font-mono text-xs text-nx-cyan tracking-widest uppercase block mb-1">01. OVERVIEW</span>
            <h2 class="font-display font-bold text-2xl text-white">
              Informasi Umum &amp; Format Kompetisi
            </h2>
          </div>

          <p>
            <strong class="text-white">NFX CTF 2026</strong> adalah kompetisi keamanan siber nasional dengan format <strong class="text-white">Jeopardy CTF</strong> yang diselenggarakan melalui kolaborasi resmi antara divisi kompetisi <strong class="text-nf-orange-bright">UKM NFCC (Nurul Fikri Cyber Security Community)</strong> dan <strong class="text-nx-cyan">NXCTF Community</strong>, dengan dukungan penuh dari institusi akademik <strong class="text-white">STT Terpadu Nurul Fikri</strong> serta sponsor utama reward <strong class="text-amber-300">LINUXENIC CORP.</strong>
          </p>
          <p>
            Awalnya diinisiasi dari program kerja internal kampus bertajuk <em>NFCTF Season 1</em> untuk pembinaan mahasiswa, inisiatif ini dielevasi menjadi ajang kompetisi skala nasional terbuka yang memfasilitasi persaingan kompetitif independen sekaligus sarana pembinaan talenta muda cybersecurity Indonesia.
          </p>

          <!-- Clean specs bar -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 font-mono text-xs">
            <div class="p-3 rounded-xl bg-surface-elevated/70 border border-white/5">
              <span class="text-text-muted text-[0.65rem] uppercase block mb-1">DURASI</span>
              <strong class="text-white block text-sm">48 Jam Non-stop</strong>
              <span class="text-text-muted text-[0.7rem]">07 Nov 14:00 – 09 Nov 14:00 WIB</span>
            </div>
            <div class="p-3 rounded-xl bg-surface-elevated/70 border border-white/5">
              <span class="text-text-muted text-[0.65rem] uppercase block mb-1">FORMAT PESERTA</span>
              <strong class="text-white block text-sm">Individu (Solo)</strong>
              <span class="text-text-muted text-[0.7rem]">Pengerjaan mandiri tanpa tim</span>
            </div>
            <div class="p-3 rounded-xl bg-surface-elevated/70 border border-white/5">
              <span class="text-text-muted text-[0.65rem] uppercase block mb-1">PLATFORM ENGINE</span>
              <strong class="text-nx-cyan block text-sm">ctf.nfx.my.id ↗</strong>
              <span class="text-text-muted text-[0.7rem]">Dynamic Decay</span>
            </div>
          </div>
        </section>

        <!-- 02. 8 Kategori Soal (Clean Grid with Lucide Icons) -->
        <section id="kategori-soal" class="scroll-mt-24 space-y-4">
          <div class="pb-2 border-b border-white/10">
            <span class="font-mono text-xs text-nx-cyan tracking-widest uppercase block mb-1">02. CHALLENGES</span>
            <h2 class="font-display font-bold text-2xl text-white">
              8 Kategori Soal Tantangan
            </h2>
          </div>

          <p>
            Soal-soal dirancang dengan spektrum kesulitan bertingkat (Beginner hingga Intermediate/Advanced) untuk menguji pemahaman teknis di berbagai disiplin offensive security:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2">
            {disciplines.map((item) => (
              <div class="p-4 rounded-xl bg-surface-elevated/60 border border-white/5 hover:border-white/15 transition-colors flex items-start gap-3.5">
                <div class={`size-9 rounded-lg flex items-center justify-center border shrink-0 ${item.color}`}>
                  <item.Icon className="size-4" />
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="font-display font-bold text-sm text-white mb-0.5">
                    {item.name}
                  </h3>
                  <p class="text-xs text-text-muted leading-relaxed font-mono">
                    {item.desc}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- 03. Jalur & Biaya Registrasi -->
        <section id="track-biaya" class="scroll-mt-24 space-y-4">
          <div class="pb-2 border-b border-white/10">
            <span class="font-mono text-xs text-nf-orange tracking-widest uppercase block mb-1">03. TRACKS &amp; FEES</span>
            <h2 class="font-display font-bold text-2xl text-white">
              Jalur Partisipasi &amp; Biaya Registrasi
            </h2>
          </div>

          <p>
            Terdapat dua jalur pendaftaran yang dapat dipilih sesuai eligibilitas peserta:
          </p>

          <div class="overflow-x-auto rounded-xl border border-white/10 bg-surface-elevated/50">
            <table class="w-full text-left font-mono text-xs">
              <thead class="bg-white/5 border-b border-white/10 text-text-muted">
                <tr>
                  <th class="p-3.5 font-bold text-white">Parameter</th>
                  <th class="p-3.5 text-nf-orange-bright font-bold">Track Mahasiswa NF</th>
                  <th class="p-3.5 text-nx-cyan font-bold">Track Umum (Nasional)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                <tr>
                  <td class="p-3.5 font-semibold text-white">Eligibilitas</td>
                  <td class="p-3.5 text-text-secondary">Mahasiswa aktif STT Terpadu Nurul Fikri</td>
                  <td class="p-3.5 text-text-secondary">Terbuka Nasional (Pelajar, Mahasiswa, Praktisi)</td>
                </tr>
                <tr>
                  <td class="p-3.5 font-semibold text-white">Biaya Registrasi</td>
                  <td class="p-3.5"><span class="text-emerald-400 font-bold">100% Gratis (Rp 0,-)</span></td>
                  <td class="p-3.5"><span class="text-nx-cyan font-bold">Rp 10.000 / Peserta (Flat)</span></td>
                </tr>
                <tr>
                  <td class="p-3.5 font-semibold text-white">Fasilitas Khusus</td>
                  <td class="p-3.5 text-white">2x Workshop Pembekalan (1 Online, 1 Offline)</td>
                  <td class="p-3.5 text-text-muted">Technical Meeting Online &amp; Discord Support</td>
                </tr>
                <tr>
                  <td class="p-3.5 font-semibold text-white">E-Certificate</td>
                  <td class="p-3.5 text-emerald-400">Minimal 1 challenge selesai (flag benar); 0 solve tidak mendapat sertifikat. Writeup opsional.</td>
                  <td class="p-3.5 text-nx-cyan">Diberikan bagi peserta yang submit Writeup</td>
                </tr>
                <tr>
                  <td class="p-3.5 font-semibold text-white">Alokasi Hadiah</td>
                  <td class="p-3.5 text-amber-300 font-semibold">Fixed Cash Rp 400.000 (Top 5) + Voucher</td>
                  <td class="p-3.5 text-emerald-400 font-semibold">Rp 300 Ribu (Sponsor) + 90% Pool Tiket + Voucher</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <CertificatePolicy />

        <!-- 04. Platform & Scoring -->
        <section id="platform-scoring" class="scroll-mt-24 space-y-4">
          <div class="pb-2 border-b border-white/10">
            <span class="font-mono text-xs text-nx-cyan tracking-widest uppercase block mb-1">04. PLATFORM</span>
            <h2 class="font-display font-bold text-2xl text-white">
              Platform NXCTF &amp; Mekanisme Dynamic Decay
            </h2>
          </div>

          <p>
            Kompetisi dioperasikan pada infrastruktur <strong class="text-white">Platform NXCTF</strong> yang menerapkan rumus penilaian dinamis (<em class="text-nx-cyan">Dynamic Scoring Engine</em>) untuk menjaga kompetisi tetap seimbang dan adil:
          </p>

          <ul class="space-y-2 pl-2">
            <li class="flex items-start gap-2.5">
              <span class="size-1.5 rounded-full bg-nx-cyan mt-2 shrink-0"></span>
              <span><strong>Maksimal 500 Poin:</strong> Setiap soal pertama kali dibuka dengan nilai awal 500 poin.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="size-1.5 rounded-full bg-nx-cyan mt-2 shrink-0"></span>
              <span><strong>Decay Parameter 20 Solver:</strong> Semakin banyak peserta yang berhasil menyelesaikan suatu soal, nilai soal tersebut akan otomatis meluruh hingga batas minimum <strong>100 Poin</strong>.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="size-1.5 rounded-full bg-nx-cyan mt-2 shrink-0"></span>
              <span><strong>Skor Retroaktif:</strong> Peserta yang menyelesaikan soal lebih awal poinnya akan disesuaikan otomatis seiring peluruhan nilai soal, merefleksikan tingkat kesulitan riil komunitas.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="size-1.5 rounded-full bg-nx-cyan mt-2 shrink-0"></span>
              <span><strong>Tie-Breaker:</strong> Jika terdapat kesamaan poin akhir di papan skor (leaderboard), pemenang ditentukan oleh peserta yang mencapai poin tersebut lebih dahulu (waktu submit tercepat).</span>
            </li>
          </ul>

          <div class="p-4 rounded-xl bg-surface-elevated/80 border-l-2 border-nx-cyan text-xs font-mono space-y-1">
            <strong class="text-white block">Distribusi Akun &amp; Kredensial:</strong>
            <p class="text-text-muted">
              Kredensial login platform (username, password acak) serta link server Discord resmi akan dikirim otomatis ke alamat email yang Anda gunakan saat mendaftar pada <strong>H-1 Technical Meeting (03 Nov 2026)</strong>.
            </p>
          </div>
        </section>

        <!-- 05. Standar Format Flag -->
        <section id="format-flag" class="scroll-mt-24 space-y-4">
          <div class="pb-2 border-b border-white/10">
            <span class="font-mono text-xs text-nf-orange tracking-widest uppercase block mb-1">05. FLAG FORMAT</span>
            <h2 class="font-display font-bold text-2xl text-white">
              Standar Format Submission Flag
            </h2>
          </div>

          <p>
            Seluruh flag rahasia yang diperoleh dari penyelesaian target challenge dibungkus dengan format resmi berikut:
          </p>

          <div class="p-4 rounded-xl bg-black/80 border border-nx-cyan/30 flex items-center justify-between font-mono text-sm">
            <code class="text-nx-cyan font-bold select-all tracking-wide">NFX&#123;flag_rahasia_anda_disini&#125;</code>
            <span class="text-[0.65rem] text-text-muted px-2 py-0.5 rounded bg-white/5 border border-white/10 uppercase">CASE-SENSITIVE</span>
          </div>

          <p class="text-xs text-text-muted">
            Pastikan menyertakan prefix <code class="text-amber-300 font-mono">NFX&#123;</code> dan kurung kurawal tutup <code class="text-amber-300 font-mono">&#125;</code> persis seperti yang ditemukan tanpa spasi atau tanda petik.
          </p>
        </section>

        <!-- 06. Pedoman Writeup -->
        <section id="pedoman-writeup" class="scroll-mt-24 space-y-4">
          <div class="pb-2 border-b border-white/10">
            <span class="font-mono text-xs text-nx-cyan tracking-widest uppercase block mb-1">06. WRITEUP</span>
            <h2 class="font-display font-bold text-2xl text-white">
              Pedoman Penulisan Laporan Writeup (WU)
            </h2>
          </div>

          <p>
            Writeup cukup berisi ringkasan cara menyelesaikan challenge. Format bebas: <strong>blog, PDF, GitHub / Markdown, Notion, atau format lainnya</strong>, asalkan dapat dibaca dan diakses panitia. Pastikan izin akses tautan sudah sesuai. Wajib untuk Track Umum dan opsional untuk Mahasiswa NF. Batas pengumpulan: <strong>13 November 2026 pukul 23:59 WIB</strong>.
          </p>

          <div class="space-y-3 font-mono text-xs pt-1">
            <div class="p-3.5 rounded-xl bg-surface-elevated/60 border border-white/5 flex items-start gap-3">
              <span class="text-nx-cyan font-bold">1.</span>
              <div>
                <strong class="text-white block">Identitas Peserta:</strong>
                <span class="text-text-muted">Nama dan username yang terdaftar di ctf.nfx.my.id.</span>
              </div>
            </div>
            <div class="p-3.5 rounded-xl bg-surface-elevated/60 border border-white/5 flex items-start gap-3">
              <span class="text-nx-cyan font-bold">2.</span>
              <div>
                <strong class="text-white block">Tangkapan Layar Scoreboard:</strong>
                <span class="text-text-muted">Screenshot posisi akhir di scoreboard track masing-masing.</span>
              </div>
            </div>
            <div class="p-3.5 rounded-xl bg-surface-elevated/60 border border-white/5 flex items-start gap-3">
              <span class="text-nx-cyan font-bold">3.</span>
              <div>
                <strong class="text-white block">Deskripsi &amp; Alur Penyelesaian:</strong>
                <span class="text-text-muted">Untuk setiap challenge yang diselesaikan, tulis nama challenge, deskripsi singkat cara penyelesaian, dan urutan langkah hingga memperoleh flag.</span>
              </div>
            </div>
            <div class="p-3.5 rounded-xl bg-surface-elevated/60 border border-white/5 flex items-start gap-3">
              <span class="text-nx-cyan font-bold">4.</span>
              <div>
                <strong class="text-white block">String Flag:</strong>
                <span class="text-text-muted">Flag utuh yang diperoleh dari masing-masing challenge.</span>
              </div>
            </div>
            <div class="p-3.5 rounded-xl bg-surface-elevated/60 border border-white/5 flex items-start gap-3">
              <span class="text-nx-cyan font-bold">5.</span>
              <div>
                <strong class="text-white block">Penggunaan AI (Opsional):</strong>
                <span class="text-text-muted">Untuk transparansi, boleh cantumkan chatbot yang digunakan (misalnya ChatGPT atau Claude), atau nama AI agent beserta modelnya jika menggunakan agent. Tambahkan keterangan singkat bantuannya, misalnya untuk memahami soal atau debugging script.</span>
              </div>
            </div>
          </div>
        </section>

        <!-- 07. Skema Hadiah & Sponsor -->
        <section id="hadiah-sponsor" class="scroll-mt-24 space-y-4">
          <div class="pb-2 border-b border-white/10">
            <span class="font-mono text-xs text-amber-400 tracking-widest uppercase block mb-1">07. REWARDS</span>
            <h2 class="font-display font-bold text-2xl text-white">
              Skema Hadiah &amp; Sponsorship Linuxenic Corp.
            </h2>
          </div>

          <p>
            Reward pemenang didukung oleh alokasi kas pendaftaran serta sponsor utama <strong class="text-amber-300">LINUXENIC CORP.</strong> yang menyediakan dana tunai Rp 300.000 dan voucher akses lab browser gratis:
          </p>

          <p>Persentase hadiah dihitung dari pool tiket saja. Sponsor Rp300.000 dibagi tetap ke juara 1–3 (Rp150.000 / Rp100.000 / Rp50.000); juara 4–5 mendapat 10% dan 5% pool tiket. Sisa 10% uang pendaftaran untuk operasional.</p>

          <!-- Formula callout -->
          <div class="p-4 rounded-xl bg-surface-elevated/80 border border-amber-400/20 font-mono text-xs space-y-1.5">
            <div class="flex items-center gap-2 text-amber-300 font-bold">
              <Coins className="size-4" />
              <span>Kalkulasi Dynamic Prize Pool (Track Umum, Top 5):</span>
            </div>
            <p class="text-text-muted text-[0.72rem]">
              Total Pool = <strong class="text-white">Rp 300.000</strong> (Sponsor Linuxenic) + (<strong class="text-emerald-400">90% × Rp 10.000 × Jumlah Peserta Umum Berbayar</strong>).
            </p>
          </div>

          <div class="overflow-x-auto rounded-xl border border-white/10 bg-surface-elevated/50">
            <table class="w-full text-left font-mono text-xs">
              <thead class="bg-white/5 border-b border-white/10 text-text-muted">
                <tr>
                  <th class="p-3.5 font-bold text-white">Peringkat</th>
                  <th class="p-3.5 text-nf-orange-bright font-bold">Track Mahasiswa NF (Fixed)</th>
                  <th class="p-3.5 text-nx-cyan font-bold">Track Umum (Dynamic Pool)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                <tr>
                  <td class="p-3.5 font-bold text-amber-300 flex items-center gap-1.5">
                    <Trophy className="size-4 text-amber-300" />
                    <span>Juara 1</span>
                  </td>
                  <td class="p-3.5">
                    <strong class="text-white block">Rp 150.000</strong>
                    <span class="text-text-muted text-[0.68rem]">+ Voucher Lab Linuxenic 1 Bulan</span>
                  </td>
                  <td class="p-3.5">
                    <strong class="text-emerald-400 font-bold block">40% Pool Tiket + Rp150.000 Sponsor</strong>
                    <span class="text-text-muted text-[0.68rem]">+ Voucher Lab Linuxenic 1 Bulan</span>
                  </td>
                </tr>
                <tr>
                  <td class="p-3.5 font-bold text-slate-300 flex items-center gap-1.5">
                    <Trophy className="size-4 text-slate-300" />
                    <span>Juara 2</span>
                  </td>
                  <td class="p-3.5">
                    <strong class="text-white">Rp 100.000</strong>
                  </td>
                  <td class="p-3.5">
                    <strong class="text-nx-cyan font-bold">30% Pool Tiket + Rp100.000 Sponsor</strong>
                  </td>
                </tr>
                <tr>
                  <td class="p-3.5 font-bold text-amber-500 flex items-center gap-1.5">
