---
import Layout from "../layouts/Layout.astro";
import BackgroundCanvas from "../components/BackgroundCanvas";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DiscordNfxModal from "../components/DiscordNfxModal";
import RegisterModal from "../components/RegisterModal";
import {
  FolderOpen,
  ExternalLink,
  Coins,
  Radio,
  FileCheck2,
  Copy,
  Phone,
  Mail,
  CheckCircle2,
  Star,
  Layers,
  HeartHandshake,
  ShieldCheck,
  Download,
  Megaphone,
  Sparkles,
  FileText,
  Image as ImageIcon,
  UserCheck,
  ArrowRight,
  Info,
} from "lucide-react";

// Google Drive Folder URL directly requested by the user
const GOOGLE_DRIVE_FOLDER_URL =
  "https://drive.google.com/drive/folders/1cfvT3gtTWYBw_WcPdvZxbQ57VOailcU8?usp=sharing";

const BANK_INFO = {
  bankName: "SeaBank",
  accountNumber: "901745979692",
  accountName: "Syauqiyah Falina Rahman",
  donationFormUrl: "https://forms.gle/nTJR4aXeG6KLK1eJ8",
};

const CONTACTS = {
  waTri: {
    name: "Tri Nurjulyanti (Humas)",
    phone: "0821-4736-7711",
    url: "https://wa.me/6282147367711?text=Halo%20Panitia%20NFX%20CTF%202026,%20saya%20tertarik%20untuk%20menjalin%20kemitraan%20Sponsorship%20/%20Media%20Partner.",
  },
  email: "nfcc@nurulfikri.ac.id",
};

// Official Sponsorship Packages (MoU Formal - Sesuai Proposal Sponsorship Bab 3.2)
const sponsorPackages = [
  {
    tier: "Bronze",
    badge: "Open (8 Slot)",
    badgeColor: "text-amber-400 bg-amber-500/10 border-amber-500/25",
    price: "Rp 100.000",
    target: "Sponsor Brand / Community",
    statusNote: "Eksposur visual dasar (Kerjasama MoU)",
    benefits: [
      "Penempatan Logo di Website Utama (nfx.my.id)",
      "Penempatan Logo pada Poster Publikasi Resmi Medsos",
      "Pencantuman nama & logo di Laporan Pertanggungjawaban (LPJ)",
    ],
    ctaText: "Pilih Paket Bronze ↗",
    ctaLink: CONTACTS.waTri.url,
    isTaken: false,
    cardBorder: "border-white/10 hover:border-amber-400/40",
  },
  {
    tier: "Silver",
    badge: "Open (5 Slot)",
    badgeColor: "text-nx-cyan bg-nx-cyan/10 border-nx-cyan/25",
    price: "Rp 250.000",
    target: "Sponsor Brand / Community",
    statusNote: "Eksposur platform CTF & Discord (Kerjasama MoU)",
    benefits: [
      "Seluruh Benefit Paket Bronze",
      "Penempatan Logo di Platform CTF (ctf.nfx.my.id)",
      "Banner resmi di Server Discord NFX CTF",
      "Opsi menyumbang beberapa challenge soal CTF bertema brand",
    ],
    ctaText: "Pilih Paket Silver ↗",
    ctaLink: CONTACTS.waTri.url,
    isTaken: false,
    cardBorder: "border-nx-cyan/30 shadow-[0_0_20px_rgba(34,211,238,0.08)] hover:border-nx-cyan/60",
  },
  {
    tier: "Gold",
    badge: "Slot Terbuka (2 Slot)",
    badgeColor: "text-amber-300 bg-amber-400/15 border-amber-400/30",
    price: "Rp 500.000",
    target: "Title Sponsor Resmi",
    statusNote: "Tersedia 2 Slot untuk Mitra Utama",
    benefits: [
      "Title Sponsor & Co-Branding Utama Platform CTF & Web",
      "Logo Eksklusif pada seluruh E-Sertifikat Pemenang",
      "Pembuatan Konten Dedikasi Produk (Review / Showcase di Medsos Resmi NFCC & NXCTF)",
      "Seluruh benefit Paket Silver",
    ],
    ctaText: "Pilih Paket Gold ↗",
    ctaLink: CONTACTS.waTri.url,
    isTaken: false,
    cardBorder: "border-amber-400/35 bg-surface/90 hover:border-amber-400",
  },
];
---

<Layout
  title="Partnership, Sponsorship & Donasi — NFX CTF 2026 | Portal Resmi Kemitraan"
  description="Portal resmi kemitraan NFX CTF 2026. Temukan informasi paket sponsorship formal (MoU), media partner, donatur sukarela, alur kerjasama resmi, dan berkas proposal di Google Drive."
>
  <BackgroundCanvas client:load />
  <Header />

  <main class="relative z-10 pt-24 pb-20 px-4 sm:px-6 lg:px-8 max-w-[1360px] mx-auto space-y-8">
    <!-- Breadcrumb & Top Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-white/5 font-mono text-xs text-text-muted">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-nx-cyan transition-colors">Beranda</a>
        <span>/</span>
        <span class="text-amber-300 font-semibold">Partnership &amp; Kemitraan</span>
      </div>
      <div class="inline-flex items-center gap-2 text-xs text-text-secondary self-start sm:self-auto">
        <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Portal Kemitraan Resmi NFX CTF 2026</span>
      </div>
    </div>

    <!-- Header / Hero Section (Clean & Balanced Width) -->
    <section class="space-y-3 max-w-4xl" data-reveal>
      <h1 class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight leading-tight">
        Kemitraan, Sponsorship <br class="hidden sm:inline" />
        <span class="gradient-text">&amp; Donasi NFX CTF 2026</span>
      </h1>

      <p class="text-text-secondary text-sm sm:text-base leading-relaxed">
        Dukung kompetisi Capture The Flag nasional kolaborasi <strong>UKM NFCC</strong> dan <strong>NXCTF Community</strong> dengan dukungan <strong>STT Terpadu Nurul Fikri</strong>. Terhubung dengan 130+ talenta mahasiswa &amp; praktisi cybersecurity se-Indonesia.
      </p>
    </section>

    <!-- Mobile Tab Switcher Pills (< lg screens) -->
    <div class="lg:hidden" data-reveal>
      <div class="grid grid-cols-3 gap-1.5 p-1.5 rounded-xl bg-surface-elevated/90 border border-white/10 backdrop-blur-md font-mono text-xs">
        <button
          type="button"
          data-tab-target="tab-sponsor"
          class="tab-btn py-2 px-2 rounded-lg font-semibold transition-all flex flex-col sm:flex-row items-center justify-center gap-1 cursor-pointer bg-amber-400 text-slate-950 shadow-sm text-center"
        >
          <Coins className="size-3.5 shrink-0" />
          <span class="truncate">Sponsor (MoU)</span>
        </button>
        <button
          type="button"
          data-tab-target="tab-medpart"
          class="tab-btn py-2 px-2 rounded-lg font-semibold transition-all flex flex-col sm:flex-row items-center justify-center gap-1 cursor-pointer text-text-secondary hover:text-white text-center"
        >
          <Radio className="size-3.5 shrink-0" />
          <span class="truncate">Medpart</span>
        </button>
        <button
          type="button"
          data-tab-target="tab-donatur"
          class="tab-btn py-2 px-2 rounded-lg font-semibold transition-all flex flex-col sm:flex-row items-center justify-center gap-1 cursor-pointer text-text-secondary hover:text-white text-center"
        >
          <HeartHandshake className="size-3.5 shrink-0" />
          <span class="truncate">Donatur</span>
        </button>
      </div>
    </div>

    <!-- Flex Layout (Matching Guidebook Design): Fixed Width Sticky Sidebar (Left) + Spacious Content Area (Right) -->
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-10 items-start">

      <!-- ========================================== -->
      <!-- LEFT SIDEBAR: Nav Tabs, Download & Kontak -->
      <!-- ========================================== -->
      <aside class="hidden lg:block w-72 xl:w-80 shrink-0 sticky top-24 self-start space-y-4 max-h-[calc(100vh-7rem)] overflow-y-auto no-scrollbar">
        <!-- Sidebar Navigation Card -->
        <div class="p-4 rounded-2xl bg-surface/85 border border-white/10 backdrop-blur-xl shadow-xl space-y-3">
          <div class="pb-2.5 border-b border-white/10">
            <span class="font-mono text-[0.68rem] text-text-muted uppercase tracking-wider block font-bold">
              // JALUR KEMITRAAN //
            </span>
            <span class="text-xs text-white font-display font-bold">Pilih Kategori Kemitraan</span>
          </div>

          <!-- Vertical Navigation Buttons -->
          <nav class="space-y-2 font-mono" id="desktop-sidebar-tabs">
            <!-- 1. Sponsorship -->
            <button
              type="button"
              data-tab-target="tab-sponsor"
              class="tab-btn w-full p-3 rounded-xl border text-left transition-all flex items-start gap-3 cursor-pointer group bg-amber-400/15 border-amber-400/50 text-white shadow-md shadow-amber-400/5"
            >
              <div class="size-8 rounded-lg bg-amber-400/20 text-amber-300 flex items-center justify-center shrink-0 border border-amber-400/30 group-hover:scale-105 transition-transform">
                <Coins className="size-4" />
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-1">
                  <strong class="font-display font-bold text-xs text-white block truncate">
                    Sponsorship (MoU)
                  </strong>
                  <span class="font-mono text-[0.6rem] px-1.5 py-0.5 rounded bg-amber-400/20 text-amber-300 font-bold shrink-0">
                    Formal
                  </span>
                </div>
                <p class="text-[0.68rem] text-text-secondary leading-snug mt-0.5 font-sans">
                  Kemitraan brand, logo exposure &amp; perjanjian kerjasama MoU resmi.
                </p>
                <div class="flex items-center gap-1 text-[0.62rem] text-amber-300/80 mt-1 font-mono">
                  <span>Bronze • Silver • Gold</span>
                </div>
              </div>
            </button>

            <!-- 2. Media Partner -->
            <button
              type="button"
              data-tab-target="tab-medpart"
              class="tab-btn w-full p-3 rounded-xl border text-left transition-all flex items-start gap-3 cursor-pointer group border-white/10 bg-surface/70 text-text-secondary hover:text-white hover:bg-surface-elevated/80 hover:border-white/20"
            >
              <div class="size-8 rounded-lg bg-white/5 text-nx-cyan flex items-center justify-center shrink-0 border border-white/10 group-hover:scale-105 transition-transform">
                <Radio className="size-4" />
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-1">
                  <strong class="font-display font-bold text-xs text-white block truncate">
                    Media Partner
                  </strong>
                  <span class="font-mono text-[0.6rem] px-1.5 py-0.5 rounded bg-nx-cyan/15 text-nx-cyan font-bold shrink-0">
                    Mutual
                  </span>
                </div>
                <p class="text-[0.68rem] text-text-secondary leading-snug mt-0.5 font-sans">
                  Barter publikasi kegiatan, poster medsos &amp; Collab Post Instagram.
                </p>
                <div class="flex items-center gap-1 text-[0.62rem] text-nx-cyan/80 mt-1 font-mono">
                  <span>Internal (3 Delegasi) / Eksternal</span>
                </div>
              </div>
            </button>

            <!-- 3. Donatur -->
            <button
              type="button"
              data-tab-target="tab-donatur"
              class="tab-btn w-full p-3 rounded-xl border text-left transition-all flex items-start gap-3 cursor-pointer group border-white/10 bg-surface/70 text-text-secondary hover:text-white hover:bg-surface-elevated/80 hover:border-white/20"
            >
              <div class="size-8 rounded-lg bg-white/5 text-emerald-400 flex items-center justify-center shrink-0 border border-white/10 group-hover:scale-105 transition-transform">
                <HeartHandshake className="size-4" />
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-1">
                  <strong class="font-display font-bold text-xs text-white block truncate">
                    Donatur (Non-MoU)
                  </strong>
                  <span class="font-mono text-[0.6rem] px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-400 font-bold shrink-0">
                    Sukarela
                  </span>
                </div>
                <p class="text-[0.68rem] text-text-secondary leading-snug mt-0.5 font-sans">
                  Dukungan perorangan/komunitas mulai Rp 50k tanpa MoU formal.
                </p>
                <div class="flex items-center gap-1 text-[0.62rem] text-emerald-400/80 mt-1 font-mono">
                  <span>Apresiasi IG &amp; Discord (Bisa Anonim)</span>
                </div>
              </div>
            </button>
          </nav>
        </div>

        <!-- Proposal Google Drive Download Card -->
        <div class="p-4 rounded-2xl bg-surface-elevated/80 border border-amber-400/30 backdrop-blur-xl shadow-lg space-y-2.5">
          <div class="flex items-center gap-2">
            <FolderOpen className="size-4 text-amber-300 shrink-0" />
            <strong class="text-white font-display text-xs font-bold block">
              Berkas Proposal di Drive
            </strong>
          </div>
          <p class="text-xs text-text-secondary leading-relaxed">
            Unduh Proposal Sponsorship, Proposal Media Partner, Proposal Donasi (.pdf), dan Poster Flyer.
          </p>
          <a
            href={GOOGLE_DRIVE_FOLDER_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl font-display font-bold text-xs bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-400 text-slate-950 hover:brightness-105 shadow-md shadow-amber-400/20 transition-all text-center"
          >
            <Download className="size-3.5 text-slate-950" />
            <span>Unduh Proposal di Drive ↗</span>
          </a>
          <a
            href="/nfxctf-sponsor-poster.png"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono text-amber-300 hover:underline flex items-center justify-center gap-1 pt-0.5"
          >
            <ImageIcon className="size-3" />
            <span>Lihat Poster Flyer Sponsor ↗</span>
          </a>
        </div>

        <!-- Sidebar Kontak Humas -->
        <div class="p-3.5 rounded-2xl bg-surface/70 border border-white/10 backdrop-blur-md space-y-2 font-mono text-xs">
          <span class="text-text-muted text-[0.62rem] uppercase tracking-wider block">
            Narahubung Kemitraan:
          </span>
          <div class="space-y-0.5">
            <strong class="text-white block font-display text-xs">{CONTACTS.waTri.name}</strong>
            <span class="text-text-secondary text-xs block">{CONTACTS.waTri.phone}</span>
            <span class="text-text-muted text-[0.68rem] block truncate">{CONTACTS.email}</span>
          </div>
          <a
            href={CONTACTS.waTri.url}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-1 py-1.5 px-2.5 rounded-lg bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 hover:bg-emerald-500 hover:text-slate-950 font-bold transition-all text-xs"
          >
            <Phone className="size-3" />
            <span>Chat WhatsApp Humas ↗</span>
          </a>
        </div>
      </aside>

      <!-- ========================================== -->
      <!-- RIGHT COLUMN: Spacious Content Area        -->
      <!-- ========================================== -->
      <div class="flex-1 min-w-0 w-full space-y-8">

        <!-- ---------------------------------------- -->
        <!-- TAB 1: SPONSORSHIP (MoU FORMAL)          -->
        <!-- ---------------------------------------- -->
        <div id="tab-sponsor" class="tab-content space-y-8" data-reveal>
          <!-- Section Title Header -->
          <div class="pb-3 border-b border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono text-xs font-bold px-2.5 py-0.5 rounded-full bg-amber-400/15 border border-amber-400/30 text-amber-300 uppercase">
                  KERJASAMA FORMAL (MoU)
                </span>
                <span class="font-mono text-xs text-text-muted">Bab 3 Proposal Sponsorship</span>
              </div>
              <h2 class="font-display font-bold text-xl sm:text-2xl text-white">
                Paket Kemitraan Sponsorship
              </h2>
            </div>
            <a
              href={CONTACTS.waTri.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-mono text-amber-300 hover:underline flex items-center gap-1 self-start sm:self-auto"
            >
              <span>Ajukan via WhatsApp ↗</span>
            </a>
          </div>

          <!-- 4 Key Value Benefits Grid (Proposal Bab 3.1) -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
            <div class="p-3.5 sm:p-4 rounded-xl bg-surface/75 border border-white/10 space-y-1.5 backdrop-blur-md">
              <div class="flex items-center gap-1.5 text-amber-400 font-display font-bold text-xs">
                <Megaphone className="size-4 shrink-0 text-amber-400" />
                <span>Brand Exposure</span>
              </div>
              <p class="text-xs text-text-secondary leading-relaxed font-sans">
                Logo tampil di website, platform CTF, scoreboard, dan poster medsos.
              </p>
            </div>
            <div class="p-3.5 sm:p-4 rounded-xl bg-surface/75 border border-white/10 space-y-1.5 backdrop-blur-md">
              <div class="flex items-center gap-1.5 text-nx-cyan font-display font-bold text-xs">
                <Sparkles className="size-4 shrink-0 text-nx-cyan" />
                <span>Promosi Produk</span>
              </div>
              <p class="text-xs text-text-secondary leading-relaxed font-sans">
                Promosi tools cybersecurity, voucher LMS, lisensi, atau platform lab.
              </p>
            </div>
            <div class="p-3.5 sm:p-4 rounded-xl bg-surface/75 border border-white/10 space-y-1.5 backdrop-blur-md">
              <div class="flex items-center gap-1.5 text-purple-400 font-display font-bold text-xs">
                <FileText className="size-4 shrink-0 text-purple-400" />
                <span>Publikasi &amp; LPJ</span>
              </div>
              <p class="text-xs text-text-secondary leading-relaxed font-sans">
                Dokumentasi resmi dan penyerahan Laporan LPJ pasca acara selesai.
              </p>
            </div>
            <div class="p-3.5 sm:p-4 rounded-xl bg-surface/75 border border-white/10 space-y-1.5 backdrop-blur-md">
              <div class="flex items-center gap-1.5 text-emerald-400 font-display font-bold text-xs">
                <ShieldCheck className="size-4 shrink-0 text-emerald-400" />
                <span>Citra Positif</span>
              </div>
              <p class="text-xs text-text-secondary leading-relaxed font-sans">
                Mendukung langsung regenerasi talenta cybersecurity generasi muda.
              </p>
            </div>
          </div>

          <!-- Tier Grid: 2-1 Layout (Bronze & Silver top row, Gold wide bottom row) -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6 items-stretch">
            {sponsorPackages.map((pkg) => {
              const isGold = pkg.tier === "Gold";
              return (
                <div
                  class={`p-5 sm:p-7 rounded-2xl bg-surface/85 border backdrop-blur-md flex flex-col justify-between motion-card transition-all ${pkg.cardBorder} ${
                    isGold ? "md:col-span-2 relative overflow-hidden shadow-xl" : ""
                  }`}
                >
                  {isGold && (
                    <div class="absolute -top-24 -right-24 w-80 h-80 bg-amber-400/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>
                  )}

                  {isGold ? (
                    <!-- Gold Tier: Clean Wide Layout spanning 2 columns -->
                    <div class="flex-1 flex flex-col justify-between">
                      <div>
                        <!-- Header Bar -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-white/10">
                          <div class="space-y-1.5">
                            <div class="flex items-center gap-2.5 flex-wrap">
                              <h3 class="font-display font-black text-2xl sm:text-3xl text-white">
                                {pkg.tier}
                              </h3>
                              <span class="text-amber-400 font-mono text-[0.68rem] font-bold px-2.5 py-0.5 rounded-full bg-amber-400/10 border border-amber-400/30 uppercase tracking-wider">
                                Tier Utama
                              </span>
                              <span class={`font-mono text-xs font-bold px-3 py-1 rounded-full border whitespace-nowrap shrink-0 ${pkg.badgeColor}`}>
                                {pkg.badge}
                              </span>
                            </div>
                            <div class="font-mono text-xs text-amber-300/85 font-medium">
                              {pkg.target} &bull; {pkg.statusNote}
                            </div>
                          </div>

                          <div class="sm:text-right shrink-0">
                            <div class="font-mono font-black text-3xl sm:text-4xl text-amber-300">
                              {pkg.price}
                            </div>
                            <div class="font-mono text-[0.7rem] text-text-muted mt-0.5">
                              Maksimal 2 Brand Partner
                            </div>
                          </div>
                        </div>

                        <!-- Benefits List: 2 columns on tablet & desktop -->
                        <div class="py-5">
                          <div class="font-mono text-xs font-bold text-amber-300/90 uppercase tracking-wider mb-3.5 flex items-center gap-2">
                            <span class="size-1.5 rounded-full bg-amber-400"></span>
                            <span>Seluruh Benefit Eksklusif Paket Gold:</span>
                          </div>
                          <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 font-mono text-xs text-text-secondary">
                            {pkg.benefits.map((b) => (
                              <li class="flex items-start gap-2.5 leading-relaxed p-3 rounded-xl bg-surface-elevated/70 border border-white/5 hover:border-amber-400/25 transition-colors">
                                <CheckCircle2 className="size-4 text-amber-400 shrink-0 mt-0.5" />
                                <span class="text-text-primary text-xs">{b}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>

                      <!-- Bottom Button Full Width -->
                      <div class="pt-4 border-t border-white/10 mt-auto">
                        <a
                          href={pkg.ctaLink}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="w-full inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl font-display font-bold text-sm bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-400 text-slate-950 hover:brightness-105 shadow-md shadow-amber-400/20 transition-all text-center"
                        >
                          <span>{pkg.ctaText}</span>
                        </a>
                      </div>
                    </div>
                  ) : (
                    <!-- Bronze & Silver Standard Cards -->
                    <div class="flex-1 flex flex-col justify-between">
                      <div>
                        <!-- Header: Tier Title (Left) + Badge Pill (Right) -->
                        <div class="mb-5 pb-4 border-b border-white/5 space-y-2">
                          <div class="flex items-center justify-between gap-2">
                            <h3 class="font-display font-extrabold text-2xl text-white">
                              {pkg.tier}
                            </h3>
                            <span class={`font-mono text-xs font-bold px-2.5 py-1 rounded-full border whitespace-nowrap shrink-0 ${pkg.badgeColor}`}>
                              {pkg.badge}
                            </span>
                          </div>

                          <div class="font-mono text-xs text-text-secondary">
                            {pkg.target}
                          </div>

                          <div class="pt-1">
                            <span class="font-mono font-bold text-2xl sm:text-3xl text-white">
                              {pkg.price}
                            </span>
                          </div>

                          <p class="font-mono text-xs text-text-muted">
                            {pkg.statusNote}
                          </p>
                        </div>

                        <!-- Benefits List -->
                        <ul class="space-y-3 font-mono text-xs text-text-secondary mb-5">
                          {pkg.benefits.map((b) => (
                            <li class="flex items-start gap-2.5 leading-relaxed">
                              <CheckCircle2 className="size-4 text-emerald-400 shrink-0 mt-0.5" />
                              <span>{b}</span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <!-- Bottom Button -->
