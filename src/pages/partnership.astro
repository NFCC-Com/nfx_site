  <!-- Tab Switching & Copy Script -->
  <script is:inline>
    (() => {
      // 2-Tab switcher
      const tabBtns = Array.from(document.querySelectorAll(".tab-btn"));
      const tabContents = Array.from(document.querySelectorAll(".tab-content"));

      function switchTab(targetId) {
        tabBtns.forEach((btn) => {
          const isTarget = btn.getAttribute("data-tab-target") === targetId;
          if (isTarget) {
            btn.classList.add("bg-amber-400", "text-slate-950", "shadow-sm");
            btn.classList.remove("text-text-secondary", "hover:text-white");
          } else {
            btn.classList.remove("bg-amber-400", "text-slate-950", "shadow-sm");
            btn.classList.add("text-text-secondary", "hover:text-white");
          }
        });

        tabContents.forEach((content) => {
          if (content.id === targetId) {
            content.classList.remove("hidden");
          } else {
            content.classList.add("hidden");
          }
        });
      }

      tabBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.getAttribute("data-tab-target");
          if (target) {
            switchTab(target);
            if (history.replaceState) {
              history.replaceState(null, "", `#${target}`);
            }
          }
        });
      });

      // Hash handler on page load
      if (window.location.hash) {
        const hash = window.location.hash.replace("#", "");
        if (hash === "tab-medpart" || hash === "media-partner" || hash === "medpart") {
          switchTab("tab-medpart");
        } else {
          switchTab("tab-sponsor");
        }
      }

      // Copy bank account
      const copyBtn = document.getElementById("copy-bank-btn");
      const copyText = document.getElementById("copy-bank-text");
      const accNum = document.getElementById("bank-acc-num");

      if (copyBtn && accNum) {
        copyBtn.addEventListener("click", async () => {
          const num = accNum.textContent.trim();
          try {
            await navigator.clipboard.writeText(num);
            if (copyText) copyText.textContent = "Tersalin!";
            setTimeout(() => {
              if (copyText) copyText.textContent = "Salin No. Rekening";
            }, 2000);
          } catch (e) {
            const input = document.createElement("input");
            input.value = num;
            document.body.appendChild(input);
            input.select();
            document.execCommand("copy");
            document.body.removeChild(input);
            if (copyText) copyText.textContent = "Tersalin!";
            setTimeout(() => {
              if (copyText) copyText.textContent = "Salin No. Rekening";
            }, 2000);
          }
        });
      }
    })();
  </script>
