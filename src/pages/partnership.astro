  <!-- 3-Tab Switching (Synchronized between Left Sidebar and Mobile Header) -->
  <script is:inline>
    (() => {
      const tabBtns = Array.from(document.querySelectorAll(".tab-btn"));
      const tabContents = Array.from(document.querySelectorAll(".tab-content"));

      function switchTab(targetId) {
        tabBtns.forEach((btn) => {
          const isTarget = btn.getAttribute("data-tab-target") === targetId;
          const isDesktop = btn.closest("#desktop-sidebar-tabs");

          if (isTarget) {
            if (isDesktop) {
              btn.classList.add("bg-amber-400/15", "border-amber-400/50", "text-white", "shadow-md", "shadow-amber-400/5");
              btn.classList.remove("border-white/10", "bg-surface/70", "text-text-secondary");
            } else {
              btn.classList.add("bg-amber-400", "text-slate-950", "shadow-sm");
              btn.classList.remove("text-text-secondary", "hover:text-white");
            }
          } else {
            if (isDesktop) {
              btn.classList.remove("bg-amber-400/15", "border-amber-400/50", "text-white", "shadow-md", "shadow-amber-400/5");
              btn.classList.add("border-white/10", "bg-surface/70", "text-text-secondary");
            } else {
              btn.classList.remove("bg-amber-400", "text-slate-950", "shadow-sm");
              btn.classList.add("text-text-secondary", "hover:text-white");
            }
          }
        });

        tabContents.forEach((content) => {
          if (content.id === targetId) {
            content.classList.remove("hidden");
          } else {
            content.classList.add("hidden");
          }
        });
      }

      tabBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.getAttribute("data-tab-target");
          if (target) {
            switchTab(target);
            if (history.replaceState) {
              history.replaceState(null, "", `#${target}`);
            }
          }
        });
      });

      // Handle URL hashes on page load & hashchange
      function handleHash() {
        if (window.location.hash) {
          const hash = window.location.hash.replace("#", "");
          if (hash === "tab-medpart" || hash === "media-partner" || hash === "medpart") {
            switchTab("tab-medpart");
          } else if (hash === "tab-donatur" || hash === "donatur" || hash === "donasi") {
            switchTab("tab-donatur");
          } else {
            switchTab("tab-sponsor");
          }
        }
      }

      handleHash();
      window.addEventListener("hashchange", handleHash);

      // Clipboard helper for bank accounts
      function setupCopy(btnId, textId, targetText) {
        const btn = document.getElementById(btnId);
        const textElem = document.getElementById(textId);
        if (!btn) return;

        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(targetText);
            if (textElem) textElem.textContent = "Tersalin!";
            setTimeout(() => {
              if (textElem) textElem.textContent = "Salin No. Rekening";
            }, 2000);
          } catch (e) {
            const input = document.createElement("input");
            input.value = targetText;
            document.body.appendChild(input);
            input.select();
            document.execCommand("copy");
            document.body.removeChild(input);
            if (textElem) textElem.textContent = "Tersalin!";
            setTimeout(() => {
              if (textElem) textElem.textContent = "Salin No. Rekening";
            }, 2000);
          }
        });
      }

      setupCopy("copy-bank-btn", "copy-bank-text", "901745979692");
      setupCopy("copy-bank-donasi-btn", "copy-bank-donasi-text", "901745979692");
    })();
  </script>
</Layout>
